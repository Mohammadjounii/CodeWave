@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function () {
            try {
                const t = localStorage.getItem('theme') || 'dark';
                if (t === 'dark') document.documentElement.classList.add('dark');
                else document.documentElement.classList.remove('dark');
            } catch (e) { document.documentElement.classList.add('dark'); }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Code Playground — CodeWave</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <script id="tw-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b887e3",
                        "primary-dark": "#9d6fd9",
                        "bg-light": "#f7f6f8",
                        "bg-dark": "#0a0a0f",
                        "surface-dark": "#111118",
                        "panel-dark": "#16161f",
                        "border-dark": "rgba(255,255,255,0.07)"
                    },
                    fontFamily: { display: "Space Grotesk" }
                }
            }
        };
    </script>

    <style>
        /* ── Material icons ── */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(155,89,245,.06); border-radius: 999px; }
        ::-webkit-scrollbar-thumb { background: #9b59f5; border-radius: 999px; box-shadow: 0 0 8px rgba(155,89,245,.7); }
        ::-webkit-scrollbar-thumb:hover { background: #b07eff; }
        * { scrollbar-width: thin; scrollbar-color: #9b59f5 rgba(155,89,245,.06); }

        /* ── Monaco scrollbars ── */
        .monaco-scrollable-element > .scrollbar { visibility: visible !important; opacity: 1 !important; }
        .monaco-scrollable-element > .scrollbar.vertical { width: 8px !important; background: rgba(255,255,255,.03) !important; }
        .monaco-scrollable-element > .scrollbar.horizontal { height: 8px !important; background: rgba(255,255,255,.03) !important; }
        .monaco-scrollable-element > .scrollbar > .slider { background: #9b59f5 !important; border-radius: 4px !important; box-shadow: 0 0 6px rgba(155,89,245,.5) !important; opacity: 1 !important; }
        .monaco-scrollable-element > .scrollbar > .slider:hover { background: #b07eff !important; }

        /* ── Language tab pill ── */
        .lang-tab { transition: all .2s ease; }
        .lang-tab.active-py  { background: rgba(59,130,246,.15); color: #60a5fa; border-color: rgba(59,130,246,.4); }
        .lang-tab.active-java { background: rgba(245,158,11,.12); color: #fbbf24; border-color: rgba(245,158,11,.35); }
        .lang-tab.active-web { background: rgba(234,88,12,.12);  color: #fb923c; border-color: rgba(234,88,12,.35); }

        /* ── Run button shine ── */
        .run-btn { position: relative; overflow: hidden; }
        .run-btn::after {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.18) 50%, transparent 100%);
            transform: translateX(-100%);
            transition: transform .6s ease;
        }
        .run-btn:hover::after { transform: translateX(100%); }
        .run-btn:disabled { opacity: .5; cursor: not-allowed; }
        .run-btn:disabled::after { display: none; }

        /* ── Output fade-in ── */
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .output-line { animation: slideUp .18s ease both; }

        /* ── Spinner ── */
        @@keyframes spin { to { transform: rotate(360deg); } }
        .spin { animation: spin .7s linear infinite; display: inline-block; }

        /* ── Cursor blink in terminal ── */
        @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
        .cursor-blink { animation: blink 1.1s step-end infinite; }

        /* ── Resize handle ── */
        .resize-handle {
            height: 5px; cursor: row-resize; flex-shrink: 0;
            background: transparent;
            transition: background .2s;
        }
        .resize-handle:hover, .resize-handle.dragging {
            background: linear-gradient(90deg, transparent, #b887e3 30%, #b887e3 70%, transparent);
        }

        /* ── Template dropdown ── */
        #template-dropdown { transition: opacity .15s, transform .15s; }
        #template-dropdown.hidden { opacity: 0; transform: translateY(-6px); pointer-events: none; }
        #template-dropdown:not(.hidden) { opacity: 1; transform: translateY(0); }

        /* ── Status badge pulse ── */
        @@keyframes statusPulse { 0%,100%{opacity:1} 50%{opacity:.45} }
        .status-running { animation: statusPulse .8s ease infinite; }

        /* ── Web iframe bg ── */
        #web-preview { background: #fff; }

        /* ── Logo theme ── */
        html:not(.dark) .logo-white { display: none !important; }
        html:not(.dark) .logo-black { display: block !important; }
        html.dark .logo-black { display: none !important; }
        html.dark .logo-white { display: block !important; }
    </style>
</head>

<body class="bg-bg-light dark:bg-bg-dark font-display text-slate-800 dark:text-slate-200 overflow-hidden">
<div class="flex h-screen w-full">

    <!-- ════════════════════════════════════════
         SIDEBAR
    ════════════════════════════════════════ -->
    @await Html.PartialAsync("_UserSidebar")

    <!-- ════════════════════════════════════════
         MAIN AREA
    ════════════════════════════════════════ -->
    <div class="flex flex-col flex-1 min-w-0 h-screen overflow-hidden">

        <!-- ── Top Toolbar ── -->
        <header class="flex items-center gap-3 px-5 py-3 border-b border-gray-200 dark:border-white/[.07]
                        bg-white dark:bg-surface-dark shrink-0 z-10">

            <!-- Title -->
            <div class="flex items-center gap-2.5 mr-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-purple-600
                             flex items-center justify-center shadow-lg shadow-primary/30">
                    <span class="material-symbols-outlined text-white text-[17px]">terminal</span>
                </div>
                <div>
                    <h1 class="text-gray-900 dark:text-white font-bold text-sm leading-tight">Code Playground</h1>
                    <p class="text-gray-500 dark:text-slate-500 text-[10px] leading-tight">Write · Run · Experiment</p>
                </div>
            </div>

            <!-- Language Tabs -->
            <div class="flex items-center gap-1.5 bg-gray-100 dark:bg-white/5 rounded-xl p-1">
                <button id="tab-python"
                        onclick="switchLanguage('python')"
                        class="lang-tab active-py flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all">
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.914 0C5.82 0 6.2 2.656 6.2 2.656l.007 2.752h5.814v.826H3.912S0 5.789 0 11.969s3.403 5.967 3.403 5.967h2.031v-2.87s-.109-3.403 3.348-3.403h5.768s3.24.052 3.24-3.131V3.131S18.28 0 11.914 0zM8.708 1.8a1.047 1.047 0 1 1 0 2.094 1.047 1.047 0 0 1 0-2.094z"/>
                        <path d="M12.086 24c6.094 0 5.714-2.656 5.714-2.656l-.007-2.752h-5.814v-.826h8.109S24 18.211 24 12.031s-3.403-5.967-3.403-5.967h-2.031v2.87s.109 3.403-3.348 3.403H9.45s-3.24-.052-3.24 3.131v5.4S5.72 24 12.086 24zm3.206-1.8a1.047 1.047 0 1 1 0-2.094 1.047 1.047 0 0 1 0 2.094z"/>
                    </svg>
                    Python
                </button>
                <button id="tab-java"
                        onclick="switchLanguage('java')"
                        class="lang-tab flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-transparent text-xs font-semibold text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-200 transition-all">
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8.851 18.56s-.917.534.653.714c1.902.218 2.874.187 4.969-.211 0 0 .552.346 1.321.646-4.699 2.013-10.633-.118-6.943-1.149M8.276 15.933s-1.028.761.542.924c2.032.209 3.636.227 6.413-.308 0 0 .384.389.987.602-5.679 1.661-12.007.13-7.942-1.218M13.116 11.475c1.158 1.333-.304 2.533-.304 2.533s2.939-1.518 1.589-3.418c-1.261-1.772-2.228-2.652 3.007-5.688 0 0-8.216 2.051-4.292 6.573M19.33 20.504s.679.559-.747.991c-2.712.822-11.288 1.069-13.669.033-.856-.373.75-.89 1.254-.998.527-.114.828-.093.828-.093-.953-.671-6.156 1.317-2.643 1.887 9.58 1.553 17.462-.7 14.977-1.82M9.292 13.21s-4.362 1.036-1.544 1.412c1.189.159 3.561.123 5.77-.062 1.806-.152 3.618-.477 3.618-.477s-.637.272-1.098.587c-4.429 1.165-12.986.623-10.522-.568 2.082-1.006 3.776-.892 3.776-.892M17.116 17.584c4.503-2.34 2.421-4.589.968-4.285-.355.074-.515.138-.515.138s.132-.207.385-.297c2.875-1.011 5.086 2.981-.928 4.562 0 .001.07-.062.09-.118M14.401 0s2.494 2.494-2.365 6.33c-3.896 3.077-.888 4.832-.001 6.836-2.274-2.053-3.943-3.858-2.824-5.539 1.644-2.469 6.197-3.665 5.19-7.627M9.734 23.924c4.322.277 10.959-.153 11.116-2.198 0 0-.302.775-3.572 1.391-3.688.694-8.239.613-10.937.168 0 0 .553.457 3.393.639"/>
                    </svg>
                    Java
                </button>
                <button id="tab-web"
                        onclick="switchLanguage('web')"
                        class="lang-tab flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-transparent text-xs font-semibold text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-200 transition-all">
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z"/>
                    </svg>
                    Web
                </button>
            </div>

            <!-- Spacer -->
            <div class="flex-1"></div>

            <!-- Template Picker -->
            <div class="relative">
                <button id="template-btn"
                        onclick="toggleTemplates()"
                        class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 dark:border-white/10
                               bg-white dark:bg-white/5 text-gray-600 dark:text-slate-400
                               hover:border-primary/50 hover:text-primary text-xs font-medium transition-all">
                    <span class="material-symbols-outlined text-base">auto_awesome</span>
                    Templates
                    <span class="material-symbols-outlined text-sm">expand_more</span>
                </button>
                <div id="template-dropdown"
                     class="hidden absolute right-0 top-full mt-1.5 w-52 bg-white dark:bg-[#1a1a26]
                            border border-gray-200 dark:border-white/10 rounded-xl shadow-2xl
                            shadow-black/30 z-50 py-1.5 overflow-hidden">
                    <p id="template-header" class="px-3 pt-1 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-slate-500">Python</p>
                    <div id="template-list" class="flex flex-col gap-0.5 px-1.5 pb-1.5"></div>
                </div>
            </div>

            <!-- Copy -->
            <button id="copy-btn"
                    onclick="copyCode()"
                    title="Copy code"
                    class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 dark:border-white/10
                           bg-white dark:bg-white/5 text-gray-600 dark:text-slate-400
                           hover:border-primary/50 hover:text-primary text-xs font-medium transition-all">
                <span class="material-symbols-outlined text-base">content_copy</span>
            </button>

            <!-- Reset -->
            <button onclick="resetCode()"
                    title="Reset to starter"
                    class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 dark:border-white/10
                           bg-white dark:bg-white/5 text-gray-600 dark:text-slate-400
                           hover:border-orange-400/50 hover:text-orange-400 text-xs font-medium transition-all">
                <span class="material-symbols-outlined text-base">restart_alt</span>
            </button>

            <!-- Run -->
            <button id="run-btn"
                    onclick="runCode()"
                    class="run-btn flex items-center gap-2 px-5 py-2 rounded-xl
                           bg-gradient-to-r from-green-500 to-emerald-400 text-white
                           font-bold text-sm shadow-lg shadow-green-500/25
                           hover:shadow-green-500/40 hover:from-green-600 hover:to-emerald-500
                           transition-all">
                <span id="run-icon" class="material-symbols-outlined text-lg leading-none">play_arrow</span>
                <span id="run-label">Run</span>
            </button>
        </header>

        <!-- ── Editor + Output split ── -->
        <div id="workspace" class="flex flex-col flex-1 min-h-0 overflow-hidden">

            <!-- EDITOR PANEL -->
            <div id="editor-panel" class="flex flex-col min-h-0" style="flex:1 1 60%">
                <!-- Editor header -->
                <div class="flex items-center justify-between px-4 py-1.5
                             bg-gray-50 dark:bg-[#1a1a26] border-b border-gray-200 dark:border-white/[.06]
                             shrink-0">
                    <div class="flex items-center gap-2">
                        <span id="file-dot" class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                        <span id="file-name" class="text-xs text-gray-500 dark:text-slate-400 font-mono">main.py</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <!-- Font size -->
                        <div class="flex items-center gap-1">
                            <button onclick="changeFontSize(-1)" title="Decrease font"
                                    class="w-5 h-5 flex items-center justify-center rounded text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-white text-xs transition-colors font-bold">A-</button>
                            <span id="font-size-label" class="text-[10px] text-gray-400 dark:text-slate-500 w-5 text-center">14</span>
                            <button onclick="changeFontSize(1)" title="Increase font"
                                    class="w-5 h-5 flex items-center justify-center rounded text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-white text-sm transition-colors font-bold">A+</button>
                        </div>
                        <!-- Cursor pos -->
                        <span id="cursor-pos" class="text-[10px] text-gray-400 dark:text-slate-500 font-mono">Ln 1, Col 1</span>
                    </div>
                </div>

                <!-- Monaco mount -->
                <div id="monaco-editor" class="flex-1 min-h-0"></div>
            </div>

            <!-- RESIZE HANDLE -->
            <div id="resize-handle" class="resize-handle" title="Drag to resize"></div>

            <!-- OUTPUT PANEL -->
            <div id="output-panel" class="flex flex-col min-h-0 border-t border-gray-200 dark:border-white/[.07]" style="flex:0 0 240px">
                <!-- Output header -->
                <div class="flex items-center justify-between px-4 py-1.5
                             bg-gray-50 dark:bg-[#1a1a26] border-b border-gray-200 dark:border-white/[.06] shrink-0">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-gray-500 dark:text-slate-400">terminal</span>
                        <span class="text-xs font-semibold text-gray-700 dark:text-slate-300">Output</span>
                        <span id="status-badge"
                              class="flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold
                                     bg-gray-200 dark:bg-white/10 text-gray-500 dark:text-slate-400">
                            <span id="status-dot" class="w-1.5 h-1.5 rounded-full bg-gray-400 dark:bg-slate-500"></span>
                            <span id="status-text">Idle</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span id="exec-time" class="text-[10px] text-gray-400 dark:text-slate-500 font-mono hidden"></span>
                        <button onclick="clearOutput()" title="Clear output"
                                class="text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-sm">delete_sweep</span>
                        </button>
                    </div>
                </div>

                <!-- Terminal / Preview area -->
                <div id="output-area" class="flex-1 min-h-0 overflow-hidden relative">
                    <!-- Text terminal (Python/Java) -->
                    <div id="terminal-output"
                         class="absolute inset-0 overflow-auto p-4 bg-[#0d0d14] font-mono text-sm leading-relaxed">
                        <div id="terminal-lines">
                            <span class="text-slate-600 text-xs select-none">// Click Run to execute your code...</span>
                        </div>
                        <span class="cursor-blink text-primary">█</span>
                    </div>
                    <!-- Web iframe preview -->
                    <iframe id="web-preview"
                            class="absolute inset-0 w-full h-full hidden"
                            sandbox="allow-scripts allow-modals"
                            title="Web preview"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCRIPTS
══════════════════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
<script>
// ─── State ───────────────────────────────────────────────
let editor      = null;
let currentLang = 'python';
let fontSize    = 14;
let isRunning   = false;
let runStart    = 0;

// ─── Starter code per language ───────────────────────────
const STARTERS = {
    python: `# Welcome to the CodeWave Playground 🐍\n\ndef greet(name):\n    return f"Hello, {name}!"\n\nprint(greet("World"))\n\n# Try something:\nfor i in range(1, 6):\n    print(f"{'⭐' * i} Level {i}")`,
    java:   `// Welcome to the CodeWave Playground ☕\n\npublic class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello, World!");\n        \n        // Try something:\n        for (int i = 1; i <= 5; i++) {\n            System.out.println("⭐".repeat(i) + " Level " + i);\n        }\n    }\n}`,
    web:    `<!DOCTYPE html>\n<html lang="en">\n<head>\n  <meta charset="UTF-8" />\n  <style>\n    body {\n      font-family: 'Segoe UI', sans-serif;\n      background: linear-gradient(135deg, #0a0a0f, #1a0a2e);\n      display: flex; align-items: center; justify-content: center;\n      min-height: 100vh; margin: 0;\n    }\n    h1 {\n      font-size: 2.5rem;\n      background: linear-gradient(90deg, #b887e3, #60a5fa, #34d399);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-align: center;\n    }\n    p { color: #94a3b8; text-align: center; }\n  </style>\n</head>\n<body>\n  <div>\n    <h1>🌊 CodeWave Playground</h1>\n    <p>Edit the HTML and click <strong style="color:#b887e3">Run</strong> to preview!</p>\n  </div>\n</body>\n</html>`
};

// ─── Templates per language ───────────────────────────────
const TEMPLATES = {
    python: [
        { label: "Hello World",      code: `print("Hello, World!")` },
        { label: "FizzBuzz",         code: `for i in range(1, 31):\n    if i % 15 == 0: print("FizzBuzz")\n    elif i % 3 == 0: print("Fizz")\n    elif i % 5 == 0: print("Buzz")\n    else: print(i)` },
        { label: "Fibonacci",        code: `def fib(n):\n    a, b = 0, 1\n    for _ in range(n):\n        print(a, end=" ")\n        a, b = b, a + b\n\nfib(10)` },
        { label: "List comprehension", code: `squares = [x**2 for x in range(1, 11)]\nprint(squares)\n\nevens = [x for x in range(20) if x % 2 == 0]\nprint(evens)` },
        { label: "Class example",    code: `class Animal:\n    def __init__(self, name, sound):\n        self.name = name\n        self.sound = sound\n\n    def speak(self):\n        return f"{self.name} says {self.sound}!"\n\ndog = Animal("Dog", "Woof")\ncat = Animal("Cat", "Meow")\nprint(dog.speak())\nprint(cat.speak())` },
    ],
    java: [
        { label: "Hello World",      code: `public class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello, World!");\n    }\n}` },
        { label: "FizzBuzz",         code: `public class Main {\n    public static void main(String[] args) {\n        for (int i = 1; i <= 30; i++) {\n            if (i % 15 == 0) System.out.println("FizzBuzz");\n            else if (i % 3 == 0) System.out.println("Fizz");\n            else if (i % 5 == 0) System.out.println("Buzz");\n            else System.out.println(i);\n        }\n    }\n}` },
        { label: "Fibonacci",        code: `public class Main {\n    public static void main(String[] args) {\n        int a = 0, b = 1;\n        for (int i = 0; i < 10; i++) {\n            System.out.print(a + " ");\n            int tmp = a + b; a = b; b = tmp;\n        }\n    }\n}` },
        { label: "ArrayList",        code: `import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        List<String> langs = new ArrayList<>(Arrays.asList("Python", "Java", "JavaScript"));\n        langs.add("Kotlin");\n        for (String l : langs) System.out.println("• " + l);\n    }\n}` },
        { label: "Class example",    code: `public class Main {\n    static class Animal {\n        String name, sound;\n        Animal(String n, String s) { name = n; sound = s; }\n        String speak() { return name + " says " + sound + "!"; }\n    }\n\n    public static void main(String[] args) {\n        System.out.println(new Animal("Dog", "Woof").speak());\n        System.out.println(new Animal("Cat", "Meow").speak());\n    }\n}` },
    ],
    web: [
        { label: "Animated gradient", code: `<!DOCTYPE html>\n<html>\n<head><style>\n  body { margin:0; background:#0a0a0f; display:flex; align-items:center; justify-content:center; height:100vh; }\n  h1 {\n    font-family:sans-serif; font-size:3rem;\n    background: linear-gradient(90deg,#b887e3,#60a5fa,#34d399,#b887e3);\n    background-size:200%;\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent;\n    animation: shift 3s linear infinite;\n  }\n  @@keyframes shift { to { background-position: 200% center; } }\n</style></head>\n<body><h1>CodeWave ✨</h1></body>\n</html>` },
        { label: "Dark card UI",     code: `<!DOCTYPE html>\n<html>\n<head><style>\n  * { box-sizing:border-box; margin:0; }\n  body { background:#0f0f17; font-family:'Segoe UI',sans-serif; display:flex; align-items:center; justify-content:center; height:100vh; }\n  .card { background:#1a1a26; border:1px solid rgba(184,135,227,.2); border-radius:16px; padding:2rem; width:300px; text-align:center; }\n  h2 { color:#fff; margin-bottom:.5rem; }\n  p  { color:#94a3b8; font-size:.9rem; }\n  button { margin-top:1rem; padding:.6rem 1.6rem; border:none; border-radius:8px; background:linear-gradient(135deg,#b887e3,#7c3aed); color:#fff; font-weight:700; cursor:pointer; }\n  button:hover { opacity:.9; }\n</style></head>\n<body><div class="card"><h2>Welcome 👋</h2><p>A dark card component built in pure HTML & CSS.</p><button>Get Started</button></div></body>\n</html>` },
        { label: "CSS animation",    code: `<!DOCTYPE html>\n<html>\n<head><style>\n  body { margin:0; background:#0a0a0f; display:flex; align-items:center; justify-content:center; height:100vh; gap:1rem; }\n  .dot { width:18px; height:18px; border-radius:50%; animation: bounce .8s ease-in-out infinite; }\n  .dot:nth-child(1) { background:#b887e3; animation-delay:0s; }\n  .dot:nth-child(2) { background:#60a5fa; animation-delay:.15s; }\n  .dot:nth-child(3) { background:#34d399; animation-delay:.3s; }\n  @@keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-28px)} }\n</style></head>\n<body><div class="dot"></div><div class="dot"></div><div class="dot"></div></body>\n</html>` },
        { label: "Counter app",      code: `<!DOCTYPE html>\n<html>\n<head><style>\n  body { background:#0f0f17; font-family:'Segoe UI',sans-serif; display:flex; align-items:center; justify-content:center; height:100vh; }\n  .counter { text-align:center; }\n  #num { font-size:5rem; font-weight:900; color:#b887e3; display:block; }\n  .btns { display:flex; gap:.8rem; justify-content:center; margin-top:1rem; }\n  button { padding:.5rem 1.4rem; border:none; border-radius:8px; font-size:1.2rem; font-weight:700; cursor:pointer; transition:.15s; }\n  #dec { background:#ef444420; color:#f87171; }\n  #rst { background:#ffffff10; color:#94a3b8; }\n  #inc { background:#22c55e20; color:#4ade80; }\n  button:hover { opacity:.8; }\n</style></head>\n<body>\n<div class="counter">\n  <span id="num">0</span>\n  <div class="btns">\n    <button id="dec" onclick="n=Math.max(-99,n-1);update()">-</button>\n    <button id="rst" onclick="n=0;update()">↺</button>\n    <button id="inc" onclick="n=Math.min(99,n+1);update()">+</button>\n  </div>\n</div>\n<script>let n=0;function update(){document.getElementById('num').textContent=n;}<\/script>\n</body>\n</html>` },
    ],
};

// ─── Language config ──────────────────────────────────────
const LANG_CONFIG = {
    python: { monacoLang: 'python', dot: '#60a5fa', fileName: 'main.py' },
    java:   { monacoLang: 'java',   dot: '#fbbf24', fileName: 'Main.java' },
    web:    { monacoLang: 'html',   dot: '#fb923c', fileName: 'index.html' },
};

// ─── Monaco init ─────────────────────────────────────────
require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
require(['vs/editor/editor.main'], function () {
    editor = monaco.editor.create(document.getElementById('monaco-editor'), {
        value: STARTERS.python,
        language: 'python',
        theme: 'vs-dark',
        fontSize: fontSize,
        fontFamily: "'Fira Code', 'Cascadia Code', 'Consolas', monospace",
        fontLigatures: true,
        minimap: { enabled: false },
        automaticLayout: true,
        scrollBeyondLastLine: false,
        wordWrap: 'off',
        lineNumbers: 'on',
        glyphMargin: false,
        folding: true,
        bracketPairColorization: { enabled: true },
        tabSize: 4,
        insertSpaces: true,
        quickSuggestions: true,
        parameterHints: { enabled: true },
        suggestOnTriggerCharacters: true,
        scrollbar: {
            vertical: 'visible', horizontal: 'visible',
            verticalScrollbarSize: 8, horizontalScrollbarSize: 8,
            useShadows: false, alwaysConsumeMouseWheel: false
        },
        padding: { top: 12, bottom: 12 },
        cursorSmoothCaretAnimation: 'on',
        smoothScrolling: true,
        renderLineHighlight: 'all',
        lineDecorationsWidth: 6,
    });

    // Cursor position indicator
    editor.onDidChangeCursorPosition(e => {
        document.getElementById('cursor-pos').textContent =
            `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
    });

    // Ctrl/Cmd+Enter → Run
    editor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, runCode);
});

// ─── Switch language ──────────────────────────────────────
function switchLanguage(lang) {
    if (lang === currentLang) return;
    currentLang = lang;

    // Update tabs
    const activeClasses = { python: 'active-py', java: 'active-java', web: 'active-web' };
    ['python', 'java', 'web'].forEach(l => {
        const tab = document.getElementById(`tab-${l}`);
        tab.classList.remove('active-py', 'active-java', 'active-web');
        tab.classList.toggle('border-transparent', l !== lang);
        tab.classList.toggle('text-gray-600', l !== lang);
        tab.classList.toggle('dark:text-slate-400', l !== lang);
        if (l === lang) tab.classList.add(activeClasses[l]);
    });

    // Update editor language & starter
    if (editor) {
        const model = editor.getModel();
        monaco.editor.setModelLanguage(model, LANG_CONFIG[lang].monacoLang);
        editor.setValue(STARTERS[lang]);
    }

    // Update file indicator
    const cfg = LANG_CONFIG[lang];
    document.getElementById('file-dot').style.background = cfg.dot;
    document.getElementById('file-name').textContent = cfg.fileName;

    // Toggle preview vs terminal
    const isWeb = lang === 'web';
    document.getElementById('terminal-output').classList.toggle('hidden', isWeb);
    document.getElementById('web-preview').classList.toggle('hidden', !isWeb);

    // Clear output
    clearOutput();
    updateTemplateDropdown();
}

// ─── Run code ────────────────────────────────────────────
async function runCode() {
    if (!editor || isRunning) return;

    const code = editor.getValue();
    if (!code.trim()) return;

    // Web preview: just inject into iframe
    if (currentLang === 'web') {
        setStatus('running');
        await new Promise(r => setTimeout(r, 120)); // tiny delay for feel
        const iframe = document.getElementById('web-preview');
        iframe.srcdoc = code;
        setStatus('success');
        return;
    }

    setRunning(true);
    setStatus('running');
    runStart = Date.now();

    try {
        const res = await fetch('/api/code/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ language: currentLang, code })
        });

        const data = await res.json();
        const elapsed = Date.now() - runStart;
        renderOutput(data.output || '', elapsed, res.ok && data.isCorrect !== false);
    } catch (err) {
        renderOutput(`Error: ${err.message}`, Date.now() - runStart, false);
        setStatus('error');
    } finally {
        setRunning(false);
    }
}

// ─── Render terminal output ───────────────────────────────
function renderOutput(text, ms, success) {
    const container = document.getElementById('terminal-lines');
    container.innerHTML = '';

    const lines = text.split('\n');
    lines.forEach((line, i) => {
        const div = document.createElement('div');
        div.className = 'output-line';
        div.style.animationDelay = `${i * 18}ms`;

        // Colour coding
        const lower = line.toLowerCase();
        if (lower.includes('error') || lower.includes('exception') || lower.includes('traceback')) {
            div.className += ' text-red-400';
        } else if (lower.includes('warning')) {
            div.className += ' text-yellow-400';
        } else if (line.startsWith('>>') || line.startsWith('  File ')) {
            div.className += ' text-slate-500';
        } else {
            div.className += ' text-green-300';
        }

        div.textContent = line || ' ';
        container.appendChild(div);
    });

    // Execution time
    const timeEl = document.getElementById('exec-time');
    timeEl.textContent = `${ms}ms`;
    timeEl.classList.remove('hidden');

    const hasError = text.toLowerCase().includes('error') || text.toLowerCase().includes('exception');
    setStatus(hasError ? 'error' : 'success');
}

// ─── Status helpers ───────────────────────────────────────
function setStatus(state) {
    const badge = document.getElementById('status-badge');
    const dot   = document.getElementById('status-dot');
    const text  = document.getElementById('status-text');

    badge.classList.remove('status-running');

    const map = {
        idle:    { dot: 'bg-gray-400 dark:bg-slate-500',  text: 'text-gray-500 dark:text-slate-400',  bg: 'bg-gray-200 dark:bg-white/10',   label: 'Idle'    },
        running: { dot: 'bg-yellow-400',                   text: 'text-yellow-400',                     bg: 'bg-yellow-400/10',                label: 'Running' },
        success: { dot: 'bg-green-400',                    text: 'text-green-400',                      bg: 'bg-green-400/10',                 label: 'Success' },
        error:   { dot: 'bg-red-400',                      text: 'text-red-400',                        bg: 'bg-red-400/10',                   label: 'Error'   },
    };
    const s = map[state] || map.idle;

    dot.className  = `w-1.5 h-1.5 rounded-full ${s.dot}`;
    text.className = `${s.text}`;
    text.textContent = s.label;
    badge.className = `flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${s.bg} ${s.text}`;

    if (state === 'running') badge.classList.add('status-running');
}

function setRunning(on) {
    isRunning = on;
    const btn   = document.getElementById('run-btn');
    const icon  = document.getElementById('run-icon');
    const label = document.getElementById('run-label');
    btn.disabled = on;
    icon.className  = on ? 'spin text-lg leading-none' : 'material-symbols-outlined text-lg leading-none';
    icon.textContent = on ? '●' : 'play_arrow';
    label.textContent = on ? 'Running…' : 'Run';
}

function clearOutput() {
    document.getElementById('terminal-lines').innerHTML =
        '<span class="text-slate-600 text-xs select-none">// Click Run to execute your code...</span>';
    document.getElementById('exec-time').classList.add('hidden');
    document.getElementById('web-preview').srcdoc = '';
    setStatus('idle');
}

// ─── Copy code ───────────────────────────────────────────
async function copyCode() {
    if (!editor) return;
    await navigator.clipboard.writeText(editor.getValue());
    const btn = document.getElementById('copy-btn');
    btn.innerHTML = '<span class="material-symbols-outlined text-base text-green-400">check</span>';
    setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-base">content_copy</span>';
    }, 1400);
}

// ─── Reset code ──────────────────────────────────────────
function resetCode() {
    if (!editor) return;
    editor.setValue(STARTERS[currentLang]);
    clearOutput();
}

// ─── Font size ───────────────────────────────────────────
function changeFontSize(delta) {
    fontSize = Math.min(24, Math.max(10, fontSize + delta));
    if (editor) editor.updateOptions({ fontSize });
    document.getElementById('font-size-label').textContent = fontSize;
}

// ─── Template dropdown ───────────────────────────────────
let dropdownOpen = false;
function toggleTemplates() {
    dropdownOpen = !dropdownOpen;
    const dd = document.getElementById('template-dropdown');
    if (dropdownOpen) {
        updateTemplateDropdown();
        dd.classList.remove('hidden');
    } else {
        dd.classList.add('hidden');
    }
}
function updateTemplateDropdown() {
    const header = document.getElementById('template-header');
    const list   = document.getElementById('template-list');
    header.textContent = { python: 'Python', java: 'Java', web: 'HTML / CSS / JS' }[currentLang];

    list.innerHTML = '';
    (TEMPLATES[currentLang] || []).forEach(t => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left px-3 py-2 text-xs rounded-lg text-gray-700 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors font-medium flex items-center gap-2';
        btn.innerHTML = `<span class="material-symbols-outlined text-[14px]">chevron_right</span>${t.label}`;
        btn.onclick = () => {
            if (editor) editor.setValue(t.code);
            clearOutput();
            toggleTemplates();
        };
        list.appendChild(btn);
    });
}
document.addEventListener('click', e => {
    const dd  = document.getElementById('template-dropdown');
    const btn = document.getElementById('template-btn');
    if (dropdownOpen && !dd.contains(e.target) && !btn.contains(e.target)) {
        dropdownOpen = false;
        dd.classList.add('hidden');
    }
});

// ─── Resize handle ───────────────────────────────────────
(function () {
    const handle       = document.getElementById('resize-handle');
    const editorPanel  = document.getElementById('editor-panel');
    const outputPanel  = document.getElementById('output-panel');
    const workspace    = document.getElementById('workspace');
    let dragging = false, startY = 0, startEditorH = 0;

    handle.addEventListener('mousedown', e => {
        dragging = true;
        startY = e.clientY;
        startEditorH = editorPanel.getBoundingClientRect().height;
        handle.classList.add('dragging');
        document.body.style.cursor = 'row-resize';
        document.body.style.userSelect = 'none';
    });

    document.addEventListener('mousemove', e => {
        if (!dragging) return;
        const totalH = workspace.getBoundingClientRect().height - handle.offsetHeight;
        const delta  = e.clientY - startY;
        const newEditorH = Math.min(totalH - 80, Math.max(100, startEditorH + delta));
        editorPanel.style.flex = `0 0 ${newEditorH}px`;
        outputPanel.style.flex = `0 0 ${totalH - newEditorH}px`;
    });

    document.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
    });
})();

// ─── Keyboard shortcut hint ──────────────────────────────
// Ctrl+Enter handled by Monaco above; show hint in status area on first visit
</script>

@* Reuse the sidebar theme toggle and profile scripts *@
