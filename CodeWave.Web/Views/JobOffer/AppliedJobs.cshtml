@{
    Layout = null;
    var applications = ViewBag.Applications as List<CodeWave.Domain.Entities.JobApplication> ?? new List<CodeWave.Domain.Entities.JobApplication>();
    var externalApplications = ViewBag.ExternalApplications as List<CodeWave.Domain.Entities.ExternalJobApplication> ?? new List<CodeWave.Domain.Entities.ExternalJobApplication>();
    var learningPath = ViewBag.LearningPath as string ?? "";
    var recommendedCourse = ViewBag.RecommendedCourse as CodeWave.Domain.Entities.Course;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // Initialize theme immediately to prevent flash
        (function() {
            try {
                const html = document.documentElement;
                const savedTheme = localStorage.getItem('theme');
                const theme = savedTheme || 'dark';
                if (theme === 'dark') {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }
            } catch(e) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Applications - CodeWave</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'FILL' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b887e3",
                        "primary-dark": "#9d6fd9",
                        "background-light": "#f7f6f8",
                        "background-dark": "#0a0a0f"
                    },
                    fontFamily: {
                        display: "Space Grotesk"
                    }
                }
            }
        };
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .modern-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(24px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .modern-card:hover {
            transform: translateY(-4px);
            border-color: rgba(184, 135, 227, 0.3);
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
        }
        .status-badge {
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }
        .status-pending {
            background: rgba(251, 191, 36, 0.15);
            color: #fbbf24;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .status-reviewed {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
        .status-accepted {
            background: rgba(34, 197, 94, 0.15);
            color: #22c55e;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }
        .status-rejected {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
    </style>
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-slate-800 dark:text-slate-200 min-h-screen">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        @await Html.PartialAsync("_UserSidebar")

        <!-- Main Content -->
        <main class="flex-1 p-6 lg:p-8 bg-background-light dark:bg-gradient-to-br dark:from-[#0a0a0f] dark:via-[#0f0f1a] dark:to-[#0a0a0f]">
            <div class="max-w-7xl mx-auto">
                <!-- Header -->
                <div class="mb-8">
                    <h1 class="text-gray-900 dark:text-white text-4xl font-black mb-2 bg-gradient-to-r from-gray-900 dark:from-white via-primary to-purple-400 bg-clip-text text-transparent">
                        My Applications
                    </h1>
                    <p class="text-gray-600 dark:text-slate-300 text-lg">Jobs you applied to from the Real Jobs section</p>
                </div>

                @if (externalApplications.Any())
                {
                    <div class="grid gap-4">
                        @foreach (var ext in externalApplications)
                        {
                            <div class="modern-card rounded-2xl p-6">
                                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                                    <div class="flex items-start gap-4 flex-1">
                                        @if (!string.IsNullOrEmpty(ext.EmployerLogo))
                                        {
                                            <img src="@ext.EmployerLogo" alt="@ext.EmployerName" class="w-12 h-12 rounded-xl object-contain bg-white/10 p-1 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center flex-shrink-0">
                                                <span class="material-symbols-outlined text-primary">business</span>
                                            </div>
                                        }
                                        <div class="flex-1">
                                            <div class="flex items-center gap-3 mb-1 flex-wrap">
                                                <h2 class="text-gray-900 dark:text-white text-xl font-bold">@ext.JobTitle</h2>
                                                <span class="status-badge" style="background:rgba(34,197,94,.15);color:#22c55e;border:1px solid rgba(34,197,94,.3);">
                                                    <span class="material-symbols-outlined text-sm">check_circle</span> Applied
                                                </span>
                                            </div>
                                            <p class="text-primary text-base font-semibold mb-2">@ext.EmployerName</p>
                                            <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
                                                @if (!string.IsNullOrEmpty(ext.JobLocation))
                                                {
                                                    <div class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-base">location_on</span>
                                                        <span>@ext.JobLocation</span>
                                                    </div>
                                                }
                                                <div class="flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-base">calendar_today</span>
                                                    <span>Applied: @ext.AppliedDate.ToString("MMM dd, yyyy")</span>
                                                </div>
                                                <div class="flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-base">percent</span>
                                                    <span>Match: @ext.MatchPercentage.ToString("F1")%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <a href="@ext.ApplyLink" target="_blank" rel="noopener noreferrer"
                                           class="px-4 py-2 bg-primary/10 text-primary rounded-lg hover:bg-primary/20 border border-primary/30 transition-all text-sm font-medium flex items-center gap-2">
                                            <span class="material-symbols-outlined text-base">open_in_new</span>
                                            <span>View Listing</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="modern-card rounded-2xl p-12 text-center">
                        <span class="material-symbols-outlined text-6xl text-slate-400 mb-4 block">public</span>
                        <h2 class="text-gray-900 dark:text-white text-2xl font-bold mb-2">No Applications Yet</h2>
                        <p class="text-slate-400 mb-6">When you click "I Applied" on a real job listing, it will appear here.</p>
                        <a href="@Url.Action("RealJobs", "JobOffer")"
                           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary to-purple-600 text-white rounded-xl hover:shadow-lg hover:shadow-primary/50 font-semibold transition-all">
                            <span>Browse Real Jobs</span>
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                        </a>
                    </div>
                }
            </div>
        </main>
    </div>
</body>
</html>
