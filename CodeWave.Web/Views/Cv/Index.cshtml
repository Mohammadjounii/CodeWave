                            <button type="submit" class="group relative overflow-hidden w-full bg-gradient-to-r from-primary to-purple-600 text-white h-12 px-6 rounded-xl flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-primary/50 font-semibold transition-all duration-300">
