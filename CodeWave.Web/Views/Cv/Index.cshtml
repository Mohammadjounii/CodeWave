                    </div>
                </div>
        </main>

</div>

<script>
    // Template selection handlers
    document.querySelectorAll('input[name="template"]').forEach(radio => {
        radio.addEventListener('change', function() {
            // Visual feedback is handled by CSS
        });
    });

    // Upgrade template selection handler
    document.querySelectorAll('input[name="upgradeTemplate"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.getElementById('upgradeTemplateInput').value = this.value;
        });
    });

    // Tab switching functionality
    function switchTab(tabName) {
        // hide all panels
        document.querySelectorAll('.tab-content').forEach(function(el) {
            el.classList.add('hidden');
            el.style.display = 'none';
        });
        // show target panel
        var target = document.getElementById('content-' + tabName);
        if (target) {
            target.classList.remove('hidden');
            target.style.display = 'block';
        }
        // update tab button styles
        document.querySelectorAll('.tab-button').forEach(function(btn) {
            btn.classList.remove('text-gray-900', 'border-primary');
            btn.classList.add('text-gray-500', 'border-transparent');
        });
        var activeBtn = document.getElementById('tab-' + tabName);
        if (activeBtn) {
            activeBtn.classList.remove('text-gray-500', 'border-transparent');
            activeBtn.classList.add('text-gray-900', 'border-primary');
        }
    }

    // Handle CV file selection
    function handleCVFileSelect(input) {
        if (input.files && input.files[0]) {
            const fileName = input.files[0].name;
            const fileSize = (input.files[0].size / (1024 * 1024)).toFixed(2);
            const display = document.getElementById('file-name-display');
            display.textContent = `Selected: ${fileName} (${fileSize} MB)`;
            display.classList.remove('hidden');
        }
    }

    // Handle CV Picture preview
    function handleCVPicturePreview(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('File size too large. Please upload an image smaller than 5MB.');
                input.value = '';
                return;
            }

            // Validate file type
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                alert('Invalid file type. Please upload a JPG, PNG, or GIF image.');
                input.value = '';
                return;
            }

            // Preview the image
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('cvPicturePreview');
                const previewImg = document.getElementById('cvPicturePreviewImg');
                if (preview && previewImg) {
                    previewImg.src = e.target.result;
                    preview.classList.remove('hidden');
                }
            };
            reader.readAsDataURL(file);
        }
    }

    // Drag and drop for CV picture
    function initializeDragAndDrop() {
        const cvPictureLabel = document.getElementById('cvPictureLabel');
        const cvPictureInput = document.getElementById('cvPictureInput');
        
        if (cvPictureLabel && cvPictureInput) {
            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                cvPictureLabel.addEventListener(eventName, preventDefaults, false);
            });

            ['dragenter', 'dragover'].forEach(eventName => {
                cvPictureLabel.addEventListener(eventName, () => {
                    cvPictureLabel.classList.add('border-primary', 'bg-primary/10');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                cvPictureLabel.addEventListener(eventName, () => {
                    cvPictureLabel.classList.remove('border-primary', 'bg-primary/10');
                }, false);
            });

            cvPictureLabel.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length > 0) {
                    cvPictureInput.files = files;
                    handleCVPicturePreview(cvPictureInput);
                }
            }, false);
        }
    }

    // Initialize default tab
    document.addEventListener('DOMContentLoaded', function() {
        switchTab('@(TempData["ActiveTab"] as string ?? "build")');
        
        // Initialize all sections as expanded by default
        const sections = ['personal', 'education', 'languages', 'spoken', 'summary', 'experience', 'certifications', 'projects', 'template'];
        sections.forEach(section => {
            const content = document.getElementById(section + '-content');
            const icon = document.getElementById(section + '-icon');
            if (content && icon) {
                content.style.display = 'block';
                icon.textContent = 'expand_less';
            }
        });
        
        // Calculate initial completion percentage
        calculateCompletion();
        
        // Add auto-save functionality (save to localStorage)
        initializeAutoSave();
        
        // Initialize drag and drop
        initializeDragAndDrop();
    });

    // Toggle section collapsible functionality
    function toggleSection(sectionId) {
        const content = document.getElementById(sectionId + '-content');
        const icon = document.getElementById(sectionId + '-icon');
        
        if (content && icon) {
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.textContent = 'expand_less';
                icon.style.transform = 'rotate(0deg)';
            } else {
                content.style.display = 'none';
                icon.textContent = 'expand_more';
                icon.style.transform = 'rotate(180deg)';
            }
        }
    }

    // Calculate CV completion percentage
    function calculateCompletion() {
        const form = document.getElementById('cvForm');
        if (!form) return;

        function filled(selector) {
            const el = form.querySelector(selector);
            return el && el.value.trim() !== '';
        }

        function jsonHasItems(id) {
            const el = document.getElementById(id);
            if (!el || !el.value) return false;
            try { const arr = JSON.parse(el.value); return Array.isArray(arr) && arr.length > 0; }
            catch { return false; }
        }

        const checks = [
            filled('input[name="fullName"]'),
            filled('input[name="email"]'),
            filled('input[name="location"]'),
            filled('input[name="phone"]'),
            filled('input[name="education"]'),
            filled('textarea[name="summary"]'),
            filled('textarea[name="programmingLanguages"]'),
            filled('textarea[name="spokenLanguages"]'),
            jsonHasItems('experienceJson'),
            jsonHasItems('certificationsJson'),
            jsonHasItems('projectsJson'),
        ];

        const completed = checks.filter(Boolean).length;
        const percentage = Math.round((completed / checks.length) * 100);
        updateCompletionUI(percentage);
    }

    // Update completion UI
    function updateCompletionUI(percentage) {
        const bar = document.getElementById('completion-bar');
        const text = document.getElementById('completion-percentage');
        
        if (bar) {
            bar.style.width = percentage + '%';
        }
        
        if (text) {
            text.textContent = percentage + '%';
        }
    }

    // Auto-save to localStorage
    function initializeAutoSave() {
        const form = document.getElementById('cvForm');
        if (!form) return;
        
        // Load saved data
        const savedData = localStorage.getItem('cvFormData');
        if (savedData && !hasFormData()) {
            try {
                const data = JSON.parse(savedData);
                Object.keys(data).forEach(key => {
                    const field = form.querySelector(`[name="${key}"]`);
                    if (field && !field.value) {
                        field.value = data[key];
                    }
                });
                calculateCompletion();
            } catch (e) {
                console.error('Error loading saved data:', e);
            }
        }
        
        // Save on input
        form.addEventListener('input', function(e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                saveFormData();
                calculateCompletion();
            }
        });
        
        // Clear saved data on successful submit
        form.addEventListener('submit', function() {
            localStorage.removeItem('cvFormData');
        });
    }

    // Save form data to localStorage
    function saveFormData() {
        const form = document.getElementById('cvForm');
        if (!form) return;
        
        const formData = new FormData(form);
        const data = {};
        
        for (let [key, value] of formData.entries()) {
            if (key !== '__RequestVerificationToken' && key !== 'cvPicture') {
                data[key] = value;
            }
        }
        
        localStorage.setItem('cvFormData', JSON.stringify(data));
    }

    // Check if form has existing data
    function hasFormData() {
        const form = document.getElementById('cvForm');
        if (!form) return false;
        
        const inputs = form.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], input[type="number"], textarea');
        for (let input of inputs) {
            if (input.value && input.value.trim() !== '') {
                return true;
            }
        }
        return false;
    }

    // Experience Management
    let experienceCounter = 0;
    let certificationCounter = 0;
    let projectCounter = 0;

    function addExperience(useIndex = null) {
        const container = document.getElementById('experiences-container');
        const index = useIndex !== null ? useIndex : experienceCounter++;
        // If we're using a specific index, make sure counter is at least that high
        if (useIndex !== null && experienceCounter <= useIndex) {
            experienceCounter = useIndex + 1;
        }
        
        const experienceHtml = `
            <div class="experience-item glass-effect p-6 rounded-xl border border-white/10" data-index="${index}">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-gray-900 dark:text-white font-semibold text-lg">Experience #${index + 1}</h3>
                    <button type="button" onclick="removeExperience(${index})" class="p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Job Title *</label>
                        <input type="text" name="exp_title_${index}" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., Software Developer" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Company Name *</label>
                        <input type="text" name="exp_company_${index}" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., Tech Corp" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Start Date</label>
                        <input type="month" name="exp_start_${index}" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">End Date (leave empty if current)</label>
                        <input type="month" name="exp_end_${index}" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Description</label>
                        <textarea name="exp_description_${index}" rows="3" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors resize-none" placeholder="Describe your responsibilities and achievements..."></textarea>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Skills Used (comma-separated)</label>
                        <input type="text" name="exp_skills_${index}" class="exp-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., JavaScript, React, Node.js" />
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', experienceHtml);
        renumberExperiences();
    }

    function renumberExperiences() {
        document.querySelectorAll('.experience-item').forEach((item, i) => {
            const h3 = item.querySelector('h3');
            if (h3) h3.textContent = `Experience #${i + 1}`;
        });
    }

    function removeExperience(index) {
        const item = document.querySelector(`.experience-item[data-index="${index}"]`);
        if (item) {
            item.remove();
            renumberExperiences();
            updateExperienceJson();
        }
    }

    function updateExperienceJson() {
        const experiences = [];
        const items = document.querySelectorAll('.experience-item');
        
        console.log('Updating experience JSON, found', items.length, 'experience items');
        
        items.forEach(item => {
            const index = item.getAttribute('data-index');
            // Search within the item for better reliability
            const title = item.querySelector(`input[name="exp_title_${index}"]`)?.value?.trim() || '';
            const company = item.querySelector(`input[name="exp_company_${index}"]`)?.value?.trim() || '';
            const startDate = item.querySelector(`input[name="exp_start_${index}"]`)?.value || '';
            const endDate = item.querySelector(`input[name="exp_end_${index}"]`)?.value || '';
            const description = item.querySelector(`textarea[name="exp_description_${index}"]`)?.value?.trim() || '';
            const skills = item.querySelector(`input[name="exp_skills_${index}"]`)?.value?.trim() || '';
            
            console.log(`Experience ${index}:`, { title, company, startDate, endDate, description, skills });
            
            // Save even if only some fields are filled (don't require both title and company)
            if (title || company || startDate || endDate || description || skills) {
                experiences.push({
                    title,
                    company,
                    startDate,
                    endDate,
                    description,
                    skills: skills ? skills.split(',').map(s => s.trim()).filter(s => s) : []
                });
            } else {
                console.log(`Skipping experience ${index} - all fields empty`);
            }
        });
        
        const experienceInput = document.getElementById('experienceJson');
        if (experienceInput) {
            experienceInput.value = JSON.stringify(experiences);
            console.log('Updated experience JSON:', experienceInput.value);
        } else {
            console.error('Experience JSON input field not found!');
        }
    }

    // Certification Management
    function addCertification(useIndex = null) {
        const container = document.getElementById('certifications-container');
        const index = useIndex !== null ? useIndex : certificationCounter++;
        // If we're using a specific index, make sure counter is at least that high
        if (useIndex !== null && certificationCounter <= useIndex) {
            certificationCounter = useIndex + 1;
        }
        
        const certHtml = `
            <div class="certification-item glass-effect p-6 rounded-xl border border-white/10" data-index="${index}">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-gray-900 dark:text-white font-semibold text-lg">Certification #${index + 1}</h3>
                    <button type="button" onclick="removeCertification(${index})" class="p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Certification Name *</label>
                        <input type="text" name="cert_name_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., AWS Certified Developer" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Institution/Issuer *</label>
                        <input type="text" name="cert_institution_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., Amazon Web Services" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Issue Date</label>
                        <input type="month" name="cert_date_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Expiry Date (if applicable)</label>
                        <input type="month" name="cert_expiry_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Skills/Languages (comma-separated)</label>
                        <input type="text" name="cert_skills_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., Cloud Computing, AWS, Python" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Certification Link/URL</label>
                        <input type="url" name="cert_link_${index}" class="cert-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="https://..." />
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', certHtml);
        renumberCertifications();
    }

    function renumberCertifications() {
        document.querySelectorAll('.certification-item').forEach((item, i) => {
            const h3 = item.querySelector('h3');
            if (h3) h3.textContent = `Certification #${i + 1}`;
        });
    }

    function removeCertification(index) {
        const item = document.querySelector(`.certification-item[data-index="${index}"]`);
        if (item) {
            item.remove();
            renumberCertifications();
            updateCertificationsJson();
        }
    }

    function updateCertificationsJson() {
        const certifications = [];
        const items = document.querySelectorAll('.certification-item');
        
        console.log('Updating certifications JSON, found', items.length, 'certification items');
        
        items.forEach(item => {
            const index = item.getAttribute('data-index');
            // Search within the item for better reliability
            const name = item.querySelector(`input[name="cert_name_${index}"]`)?.value?.trim() || '';
            const institution = item.querySelector(`input[name="cert_institution_${index}"]`)?.value?.trim() || '';
            const date = item.querySelector(`input[name="cert_date_${index}"]`)?.value || '';
            const expiry = item.querySelector(`input[name="cert_expiry_${index}"]`)?.value || '';
            const skills = item.querySelector(`input[name="cert_skills_${index}"]`)?.value?.trim() || '';
            const link = item.querySelector(`input[name="cert_link_${index}"]`)?.value?.trim() || '';
            
            console.log(`Certification ${index}:`, { name, institution, date, expiry, skills, link });
            
            if (name || institution || date || expiry || skills || link) {
                certifications.push({
                    name,
                    institution,
                    date,
                    expiry,
                    skills: skills ? skills.split(',').map(s => s.trim()).filter(s => s) : [],
                    link
                });
            } else {
                console.log(`Skipping certification ${index} - all fields empty`);
            }
        });
        
        const certificationsInput = document.getElementById('certificationsJson');
        if (certificationsInput) {
            certificationsInput.value = JSON.stringify(certifications);
            console.log('Updated certifications JSON:', certificationsInput.value);
        } else {
            console.error('Certifications JSON input field not found!');
        }
    }

    // Load existing experiences and certifications from JSON
    function loadExperiencesAndCertifications() {
        const experienceJson = document.getElementById('experienceJson')?.value;
        const certificationsJson = document.getElementById('certificationsJson')?.value;
        
        console.log('Loading experiences from JSON:', experienceJson);
        console.log('Loading certifications from JSON:', certificationsJson);
        
        if (experienceJson && experienceJson.trim() !== '' && experienceJson !== '[]' && experienceJson.trim() !== '""') {
            try {
                const experiences = JSON.parse(experienceJson);
                if (Array.isArray(experiences) && experiences.length > 0) {
                    experiences.forEach((exp, arrayIndex) => {
                        // Use the current counter value as the index for the new item
                        const currentIndex = experienceCounter;
                        addExperience(currentIndex);
                        experienceCounter++;
                        
                        // Wait for the DOM to update, then populate the fields
                        // Use a retry mechanism to ensure fields are ready
                        let retries = 0;
                        const maxRetries = 10;
                        const tryPopulate = () => {
                            const titleInput = document.querySelector(`input[name="exp_title_${currentIndex}"]`);
                            const companyInput = document.querySelector(`input[name="exp_company_${currentIndex}"]`);
                            const startInput = document.querySelector(`input[name="exp_start_${currentIndex}"]`);
                            const endInput = document.querySelector(`input[name="exp_end_${currentIndex}"]`);
                            const descInput = document.querySelector(`textarea[name="exp_description_${currentIndex}"]`);
                            const skillsInput = document.querySelector(`input[name="exp_skills_${currentIndex}"]`);
                            
                            if (titleInput || retries >= maxRetries) {
                                if (titleInput) {
                                    titleInput.value = exp.title || '';
                                    titleInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (companyInput) {
                                    companyInput.value = exp.company || '';
                                    companyInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (startInput) {
                                    startInput.value = exp.startDate || '';
                                    startInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (endInput) {
                                    endInput.value = exp.endDate || '';
                                    endInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (descInput) {
                                    descInput.value = exp.description || '';
                                    descInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (skillsInput) {
                                    skillsInput.value = exp.skills ? (Array.isArray(exp.skills) ? exp.skills.join(', ') : exp.skills) : '';
                                    skillsInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                console.log(`Loaded experience ${currentIndex}:`, exp);
                            } else {
                                retries++;
                                setTimeout(tryPopulate, 50);
                            }
                        };
                        setTimeout(tryPopulate, 100 * (arrayIndex + 1)); // Stagger the timeouts to avoid conflicts
                    });
                    // Don't update JSON immediately after loading - wait for all fields to be populated
                    // After all fields are populated, update the JSON to sync with form fields
                    setTimeout(() => {
                        console.log('All experiences loaded, fields populated');
                        // Update JSON to ensure it matches the populated form fields
                        updateExperienceJson();
                    }, 300 + (experiences.length * 150));
                }
            } catch (e) {
                console.error('Error loading experiences:', e);
                // If it's not JSON, it might be plain text - leave it as is
            }
        }
        
        if (certificationsJson && certificationsJson.trim() !== '' && certificationsJson !== '[]' && certificationsJson.trim() !== '""') {
            try {
                const certifications = JSON.parse(certificationsJson);
                if (Array.isArray(certifications) && certifications.length > 0) {
                    certifications.forEach((cert, arrayIndex) => {
                        // Use the current counter value as the index for the new item
                        const currentIndex = certificationCounter;
                        addCertification(currentIndex);
                        certificationCounter++;
                        
                        // Wait for the DOM to update, then populate the fields
                        // Use a retry mechanism to ensure fields are ready
                        let retries = 0;
                        const maxRetries = 10;
                        const tryPopulate = () => {
                            const nameInput = document.querySelector(`input[name="cert_name_${currentIndex}"]`);
                            const instInput = document.querySelector(`input[name="cert_institution_${currentIndex}"]`);
                            const dateInput = document.querySelector(`input[name="cert_date_${currentIndex}"]`);
                            const expiryInput = document.querySelector(`input[name="cert_expiry_${currentIndex}"]`);
                            const skillsInput = document.querySelector(`input[name="cert_skills_${currentIndex}"]`);
                            const linkInput = document.querySelector(`input[name="cert_link_${currentIndex}"]`);
                            
                            if (nameInput || retries >= maxRetries) {
                                if (nameInput) {
                                    nameInput.value = cert.name || '';
                                    nameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (instInput) {
                                    instInput.value = cert.institution || '';
                                    instInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (dateInput) {
                                    dateInput.value = cert.date || '';
                                    dateInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (expiryInput) {
                                    expiryInput.value = cert.expiry || '';
                                    expiryInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (skillsInput) {
                                    skillsInput.value = cert.skills ? (Array.isArray(cert.skills) ? cert.skills.join(', ') : cert.skills) : '';
                                    skillsInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (linkInput) {
                                    linkInput.value = cert.link || '';
                                    linkInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                console.log(`Loaded certification ${currentIndex}:`, cert);
                            } else {
                                retries++;
                                setTimeout(tryPopulate, 50);
                            }
                        };
                        setTimeout(tryPopulate, 100 * (arrayIndex + 1)); // Stagger the timeouts to avoid conflicts
                    });
                    // After all fields are populated, update the JSON to sync with form fields
                    setTimeout(() => {
                        console.log('All certifications loaded, fields populated');
                        // Update JSON to ensure it matches the populated form fields
                        updateCertificationsJson();
                    }, 300 + (certifications.length * 150));
                }
            } catch (e) {
                console.error('Error loading certifications:', e);
                // If it's not JSON, it might be plain text - leave it as is
            }
        }
    }

    // Debounced JSON sync (no localStorage — database is the source of truth)
    let saveTimeout;
    function autoSaveToLocalStorage() {
        clearTimeout(saveTimeout);
        saveTimeout = setTimeout(() => {
            updateExperienceJson();
            updateCertificationsJson();
            updateProjectsJson();
        }, 1000);
    }

    // Update JSON on input changes
    document.addEventListener('DOMContentLoaded', function() {
        // Add event listeners for experience, certification, and project fields
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('exp-field')) {
                updateExperienceJson();
                autoSaveToLocalStorage();
            }
            if (e.target.classList.contains('cert-field')) {
                updateCertificationsJson();
                autoSaveToLocalStorage();
            }
            if (e.target.classList.contains('proj-field')) {
                updateProjectsJson();
                autoSaveToLocalStorage();
            }
        });
        
        // Load existing data from database first
        // Wait a bit to ensure DOM and hidden fields are ready
        setTimeout(() => {
            console.log('=== Loading CV Data ===');
            
            // Ensure sections are expanded so fields are accessible
            ['experience', 'certifications', 'projects'].forEach(sectionId => {
                const content = document.getElementById(sectionId + '-content');
                const icon = document.getElementById(sectionId + '-icon');
                if (content && icon) {
                    content.style.display = 'block';
                    icon.textContent = 'expand_less';
                }
            });
            
            const experienceInput = document.getElementById('experienceJson');
            const certificationsInput = document.getElementById('certificationsJson');
            const projectsInput = document.getElementById('projectsJson');
            
            console.log('Experience JSON value:', experienceInput?.value);
            console.log('Certifications JSON value:', certificationsInput?.value);
            console.log('Projects JSON value:', projectsInput?.value);
            
            // Ensure empty values are set to "[]" for proper JSON handling
            if (experienceInput && (!experienceInput.value || experienceInput.value.trim() === '')) {
                experienceInput.value = '[]';
            }
            if (certificationsInput && (!certificationsInput.value || certificationsInput.value.trim() === '')) {
                certificationsInput.value = '[]';
            }
            if (projectsInput && (!projectsInput.value || projectsInput.value.trim() === '')) {
                projectsInput.value = '[]';
            }
            
            // Load data from database
            loadExperiencesAndCertifications();
            loadProjects();
            
            // Clear any stale data left over from previous sessions
            localStorage.removeItem('cv_experience');
            localStorage.removeItem('cv_certifications');
            localStorage.removeItem('cv_projects');
        }, 200);
        
        // Scroll to bottom after save redirect — wait for dynamic content to finish rendering
        if (localStorage.getItem('cv_scroll_after_save')) {
            localStorage.removeItem('cv_scroll_after_save');
            let lastHeight = 0, stable = 0;
            const poll = setInterval(() => {
                const h = document.documentElement.scrollHeight;
                if (h === lastHeight) {
                    if (++stable >= 4) {
                        clearInterval(poll);
                        window.scrollTo({ top: h, behavior: 'instant' });
                    }
                } else {
                    stable = 0;
                    lastHeight = h;
                }
            }, 150);
        }

        // Update JSON before form submission
        const form = document.getElementById('cvForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                localStorage.setItem('cv_scroll_after_save', '1');
                
                // Update all JSON fields before submission
                updateExperienceJson();
                updateCertificationsJson();
                updateProjectsJson();
                
                // Wait a moment for JSON updates to complete
                setTimeout(() => {
                    // Ensure empty arrays are saved as "[]" not empty string
                    const experienceInput = document.getElementById('experienceJson');
                    const certificationsInput = document.getElementById('certificationsJson');
                    const projectsInput = document.getElementById('projectsJson');
                    
                    if (experienceInput && (!experienceInput.value || experienceInput.value.trim() === '')) {
                        experienceInput.value = '[]';
                    }
                    if (certificationsInput && (!certificationsInput.value || certificationsInput.value.trim() === '')) {
                        certificationsInput.value = '[]';
                    }
                    if (projectsInput && (!projectsInput.value || projectsInput.value.trim() === '')) {
                        projectsInput.value = '[]';
                    }
                    
                    console.log('Final experience JSON:', experienceInput?.value);
                    console.log('Final certifications JSON:', certificationsInput?.value);
                    console.log('Final projects JSON:', projectsInput?.value);
                    
                    // Clear localStorage on successful submit
                    localStorage.removeItem('cv_experience');
                    localStorage.removeItem('cv_certifications');
                    localStorage.removeItem('cv_projects');
                    
                    console.log('=== Form Submission Data Ready ===');
                }, 100);
            });
        }
    });

    // Project Management
    function addProject() {
        const container = document.getElementById('projects-container');
        const index = projectCounter++;
        
        const projectHtml = `
            <div class="project-item glass-effect p-6 rounded-xl border border-white/10" data-index="${index}">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-gray-900 dark:text-white font-semibold text-lg">Project #${index + 1}</h3>
                    <button type="button" onclick="removeProject(${index})" class="p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Project Name *</label>
                        <input type="text" name="proj_name_${index}" class="proj-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., E-commerce Platform" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Description</label>
                        <textarea name="proj_description_${index}" rows="3" class="proj-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors resize-none" placeholder="Brief description of the project, what it does, and key features..."></textarea>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Technologies Used (comma-separated)</label>
                        <input type="text" name="proj_technologies_${index}" class="proj-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="e.g., React, Node.js, MongoDB, Express.js" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Project Link/URL</label>
                        <input type="url" name="proj_link_${index}" class="proj-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" placeholder="https://github.com/username/project" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Completion Date</label>
                        <input type="month" name="proj_date_${index}" class="proj-field w-full px-4 py-3 bg-gray-100 dark:bg-white/5 border border-gray-300 dark:border-white/10 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', projectHtml);
        renumberProjects();
    }

    function renumberProjects() {
        document.querySelectorAll('.project-item').forEach((item, i) => {
            const h3 = item.querySelector('h3');
            if (h3) h3.textContent = `Project #${i + 1}`;
        });
    }

    function removeProject(index) {
        const item = document.querySelector(`.project-item[data-index="${index}"]`);
        if (item) {
            item.remove();
            renumberProjects();
            updateProjectsJson();
        }
    }

    function updateProjectsJson() {
        const projects = [];
        const items = document.querySelectorAll('.project-item');
        
        console.log('Updating projects JSON, found', items.length, 'project items');
        
        items.forEach(item => {
            const index = item.getAttribute('data-index');
            // Search within the item for better reliability
            const name = item.querySelector(`input[name="proj_name_${index}"]`)?.value?.trim() || '';
            const description = item.querySelector(`textarea[name="proj_description_${index}"]`)?.value?.trim() || '';
            const technologies = item.querySelector(`input[name="proj_technologies_${index}"]`)?.value?.trim() || '';
            const link = item.querySelector(`input[name="proj_link_${index}"]`)?.value?.trim() || '';
            const date = item.querySelector(`input[name="proj_date_${index}"]`)?.value || '';
            
            console.log(`Project ${index}:`, { name, description, technologies, link, date });
            
            if (name || description || technologies || link || date) {
                projects.push({
                    name,
                    description,
                    technologies: technologies ? technologies.split(',').map(t => t.trim()).filter(t => t) : [],
                    link,
                    date
                });
            } else {
                console.log(`Skipping project ${index} - all fields empty`);
            }
        });
        
        const projectsInput = document.getElementById('projectsJson');
        if (projectsInput) {
            projectsInput.value = JSON.stringify(projects);
            console.log('Updated projects JSON:', projectsInput.value);
        } else {
            console.error('Projects JSON input field not found!');
        }
    }

    // Load existing projects from JSON
    function loadProjects() {
        const projectsJson = document.getElementById('projectsJson')?.value;
        
        console.log('Loading projects from JSON:', projectsJson);
        
        if (projectsJson && projectsJson.trim() !== '' && projectsJson !== '[]' && projectsJson.trim() !== '""') {
            try {
                const projects = JSON.parse(projectsJson);
                if (Array.isArray(projects) && projects.length > 0) {
                    projects.forEach((proj, arrayIndex) => {
                        // Use the current counter value as the index for the new item
                        const currentIndex = projectCounter;
                        addProject(currentIndex);
                        projectCounter++;
                        
                        // Wait for the DOM to update, then populate the fields
                        // Use a retry mechanism to ensure fields are ready
                        let retries = 0;
                        const maxRetries = 10;
                        const tryPopulate = () => {
                            const nameInput = document.querySelector(`input[name="proj_name_${currentIndex}"]`);
                            const descInput = document.querySelector(`textarea[name="proj_description_${currentIndex}"]`);
                            const techInput = document.querySelector(`input[name="proj_technologies_${currentIndex}"]`);
                            const linkInput = document.querySelector(`input[name="proj_link_${currentIndex}"]`);
                            const dateInput = document.querySelector(`input[name="proj_date_${currentIndex}"]`);
                            
                            if (nameInput || retries >= maxRetries) {
                                if (nameInput) {
                                    nameInput.value = proj.name || '';
                                    nameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (descInput) {
                                    descInput.value = proj.description || '';
                                    descInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (techInput) {
                                    techInput.value = proj.technologies ? (Array.isArray(proj.technologies) ? proj.technologies.join(', ') : proj.technologies) : '';
                                    techInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (linkInput) {
                                    linkInput.value = proj.link || '';
                                    linkInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                if (dateInput) {
                                    dateInput.value = proj.date || '';
                                    dateInput.dispatchEvent(new Event('input', { bubbles: true }));
                                }
                                console.log(`Loaded project ${currentIndex}:`, proj);
                            } else {
                                retries++;
                                setTimeout(tryPopulate, 50);
                            }
                        };
                        setTimeout(tryPopulate, 100 * (arrayIndex + 1)); // Stagger the timeouts to avoid conflicts
                    });
                    // After all fields are populated, update the JSON to sync with form fields
                    setTimeout(() => {
                        console.log('All projects loaded, fields populated');
                        // Update JSON to ensure it matches the populated form fields
                        updateProjectsJson();
                    }, 300 + (projects.length * 150));
                }
            } catch (e) {
                console.error('Error loading projects:', e);
                // If it's not JSON, try to parse as plain text
                try {
                    // Try to parse old format
                    if (projectsJson.includes('Description:') || projectsJson.includes('Technologies:')) {
                        const projectSections = projectsJson.split(/\n\n+/);
                        projectSections.forEach((section, index) => {
                            if (section.trim()) {
                                projectCounter = Math.max(projectCounter, index + 1);
                                addProject();
                                setTimeout(() => {
                                    const lines = section.split('\n').filter(l => l.trim());
                                    if (lines.length > 0) {
                                        const nameInput = document.querySelector(`input[name="proj_name_${index}"]`);
                                        if (nameInput) nameInput.value = lines[0].trim();
                                        
                                        lines.forEach(line => {
                                            if (line.includes('Description:')) {
                                                const descInput = document.querySelector(`textarea[name="proj_description_${index}"]`);
                                                if (descInput) descInput.value = line.replace('Description:', '').trim();
                                            }
                                            if (line.includes('Technologies:') || line.includes('Tech:')) {
                                                const techInput = document.querySelector(`input[name="proj_technologies_${index}"]`);
                                                if (techInput) techInput.value = line.replace(/Technologies?:/, '').trim();
                                            }
                                            if (line.includes('Link:') || line.startsWith('http')) {
                                                const linkInput = document.querySelector(`input[name="proj_link_${index}"]`);
                                                if (linkInput) linkInput.value = line.replace('Link:', '').trim();
                                            }
                                        });
                                    }
                                }, 100);
                            }
                        });
                        setTimeout(() => updateProjectsJson(), 200);
                    }
                } catch (e2) {
                    console.error('Error parsing projects as text:', e2);
                }
            }
        }
    }
</script>

