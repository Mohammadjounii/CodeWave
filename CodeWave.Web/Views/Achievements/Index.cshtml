@using CodeWave.Domain.Entities
@{
    Layout = null;
    var all       = ViewBag.All      as List<Achievement> ?? new List<Achievement>();
    var earned    = ViewBag.Earned   as List<UserAchievement> ?? new List<UserAchievement>();
    var earnedIds = ViewBag.EarnedIds as HashSet<Guid> ?? new HashSet<Guid>();
    int totalXP   = (int)(ViewBag.TotalXP ?? 0);
    int count     = (int)(ViewBag.Count   ?? 0);
    int total     = (int)(ViewBag.Total   ?? 0);
    int pct       = total > 0 ? (int)Math.Round((double)count / total * 100) : 0;

    var categories = all.Select(a => a.Category).Distinct().OrderBy(c => c).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function(){
            try{
                var t=localStorage.getItem('theme')||'dark';
                if(t==='dark')document.documentElement.classList.add('dark');
                else document.documentElement.classList.remove('dark');
            }catch(e){document.documentElement.classList.add('dark');}
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Achievements — CodeWave</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode:"class",
            theme:{extend:{
                colors:{primary:"#b887e3","primary-dark":"#9d6fd9","bg-light":"#f7f6f8","bg-dark":"#0a0a0f","surface-dark":"#111118"},
                fontFamily:{display:"Space Grotesk"}
            }}
        };
    </script>
    <style>
        .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;}

        /* scrollbar */
        ::-webkit-scrollbar{width:8px;height:8px;}
        ::-webkit-scrollbar-track{background:rgba(155,89,245,.06);border-radius:999px;}
        ::-webkit-scrollbar-thumb{background:#9b59f5;border-radius:999px;}
        *{scrollbar-width:thin;scrollbar-color:#9b59f5 rgba(155,89,245,.06);}

        /* badge card */
        .badge-card{transition:transform .25s cubic-bezier(.4,0,.2,1),box-shadow .25s;}
        .badge-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.35);}
        .badge-card.locked{filter:grayscale(.85);}
        .badge-card.locked:hover{transform:translateY(-2px);}

        /* shine on earned badges */
        @@keyframes shine{0%{background-position:-200% center;}100%{background-position:200% center;}}
        .badge-shine{
            background:linear-gradient(90deg,transparent 30%,rgba(255,255,255,.18) 50%,transparent 70%);
            background-size:200% auto;
            animation:shine 3s linear infinite;
        }

        /* progress ring */
        .progress-ring-circle{transition:stroke-dashoffset .8s cubic-bezier(.4,0,.2,1);}

        /* XP counter */
        @@keyframes countUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
        .count-up{animation:countUp .5s ease both;}

        /* category filter */
        .cat-btn{transition:all .18s;}
        .cat-btn.active{background:linear-gradient(135deg,#b887e3,#7c3aed);color:#fff;border-color:transparent;}

        /* staggered card entry */
        @@keyframes cardIn{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
        .badge-card{animation:cardIn .35s ease both;}

        /* recently earned pulse */
        @@keyframes badgePulse{0%,100%{box-shadow:0 0 0 0 rgba(184,135,227,.6);}70%{box-shadow:0 0 0 10px rgba(184,135,227,0);}}
        .badge-new{animation:badgePulse 2s ease 3;}

        /* logo */
        html:not(.dark) .logo-white{display:none!important;}
        html:not(.dark) .logo-black{display:block!important;}
        html.dark .logo-black{display:none!important;}
        html.dark .logo-white{display:block!important;}
    </style>
</head>
<body class="bg-bg-light dark:bg-bg-dark font-display text-slate-800 dark:text-slate-200 min-h-screen">
<div class="flex min-h-screen">

    @await Html.PartialAsync("_UserSidebar")

    <main class="flex-1 overflow-y-auto p-6 lg:p-8">

        <!-- ── Page header ──────────────────────────────────── -->
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white
                                bg-gradient-to-r from-gray-900 dark:from-white via-primary to-purple-400
                                bg-clip-text text-transparent mb-1">
                        Achievements
                    </h1>
                    <p class="text-gray-500 dark:text-slate-400 text-sm">Track your milestones and collect badges as you grow</p>
                </div>
            </div>
        </div>

        <!-- ── Stats row ─────────────────────────────────────── -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">

            <!-- Progress ring card -->
            <div class="sm:col-span-1 bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10
                         rounded-2xl p-6 flex items-center gap-5">
                <div class="relative w-20 h-20 shrink-0">
                    <svg class="w-20 h-20 -rotate-90" viewBox="0 0 80 80">
                        <circle cx="40" cy="40" r="34" fill="none"
                                stroke="currentColor" stroke-width="7"
                                class="text-gray-100 dark:text-white/10"/>
                        <circle cx="40" cy="40" r="34" fill="none"
                                stroke="url(#ringGrad)" stroke-width="7"
                                stroke-linecap="round"
                                class="progress-ring-circle"
                                stroke-dasharray="213.6"
                                stroke-dashoffset="@(213.6 - 213.6 * pct / 100)"/>
                        <defs>
                            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%"   stop-color="#b887e3"/>
                                <stop offset="100%" stop-color="#7c3aed"/>
                            </linearGradient>
                        </defs>
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center text-sm font-black text-gray-900 dark:text-white">@pct%</span>
                </div>
                <div>
                    <p class="text-2xl font-black text-gray-900 dark:text-white">@count <span class="text-gray-400 dark:text-slate-500 font-medium text-base">/ @total</span></p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-0.5">Badges earned</p>
                </div>
            </div>

            <!-- XP card -->
            <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10
                         rounded-2xl p-6 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500
                             flex items-center justify-center shadow-lg shadow-amber-500/25 shrink-0">
                    <span class="material-symbols-outlined text-white text-xl">bolt</span>
                </div>
                <div>
                    <p class="text-2xl font-black text-gray-900 dark:text-white count-up">@totalXP <span class="text-amber-400 text-sm font-bold">XP</span></p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-0.5">Total XP earned</p>
                </div>
            </div>

            <!-- Latest badge -->
            @{
                var latest = earned.FirstOrDefault();
            }
            <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10
                         rounded-2xl p-6 flex items-center gap-4 overflow-hidden relative">
                @if (latest != null)
                {
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shrink-0
                                 shadow-lg"
                         style="background:linear-gradient(135deg,@latest.Achievement.GradientFrom,@latest.Achievement.GradientTo)">
                        @latest.Achievement.Icon
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs text-gray-400 dark:text-slate-500 mb-0.5">Latest achievement</p>
                        <p class="font-bold text-gray-900 dark:text-white truncate">@latest.Achievement.Name</p>
                        <p class="text-xs text-gray-500 dark:text-slate-400">@latest.EarnedAt.ToString("MMM d, yyyy")</p>
                    </div>
                    <div class="absolute -right-4 -top-4 w-20 h-20 rounded-full opacity-10"
                         style="background:linear-gradient(135deg,@latest.Achievement.GradientFrom,@latest.Achievement.GradientTo)"></div>
                }
                else
                {
                    <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-white/5 flex items-center justify-center text-2xl shrink-0">🎯</div>
                    <div>
                        <p class="text-xs text-gray-400 dark:text-slate-500 mb-0.5">Latest achievement</p>
                        <p class="font-bold text-gray-900 dark:text-white">None yet</p>
                        <p class="text-xs text-gray-500 dark:text-slate-400">Complete a lesson to start!</p>
                    </div>
                }
            </div>
        </div>

        <!-- ── Category filter ────────────────────────────────── -->
        <div class="flex flex-wrap gap-2 mb-6" id="cat-filter">
            <button onclick="filterCat('all')" id="cat-all"
                    class="cat-btn active px-4 py-1.5 rounded-full border border-gray-200 dark:border-white/10
                           text-sm font-semibold text-gray-700 dark:text-slate-300 bg-white dark:bg-white/5">
                All <span class="ml-1 text-xs opacity-60">@total</span>
            </button>
            @foreach (var cat in categories)
            {
                var catCount = all.Count(a => a.Category == cat);
                var earnedInCat = earned.Count(ua => ua.Achievement.Category == cat);
                <button onclick="filterCat('@cat')" id="cat-@cat.ToLower().Replace(" ", "-")"
                        class="cat-btn px-4 py-1.5 rounded-full border border-gray-200 dark:border-white/10
                               text-sm font-semibold text-gray-700 dark:text-slate-300 bg-white dark:bg-white/5">
                    @cat <span class="ml-1 text-xs opacity-60">@earnedInCat/@catCount</span>
                </button>
            }
        </div>

        <!-- ── Badge grid ─────────────────────────────────────── -->
        <div id="badge-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            @{
                // Show earned first, then locked
                var sorted = all
                    .OrderByDescending(a => earnedIds.Contains(a.Id))
                    .ThenBy(a => a.Category)
                    .ThenBy(a => a.XPValue)
                    .ToList();
                int cardIdx = 0;
            }
            @foreach (var a in sorted)
            {
                var isEarned = earnedIds.Contains(a.Id);
                var ua       = earned.FirstOrDefault(u => u.AchievementId == a.Id);
                var isNew    = ua != null && (DateTime.UtcNow - ua.EarnedAt).TotalHours < 24;
                <div class="badge-card @(isEarned ? "" : "locked") @(isNew ? "badge-new" : "") rounded-2xl overflow-hidden
                             border @(isEarned ? "border-gray-200 dark:border-white/10" : "border-gray-100 dark:border-white/5")
                             bg-white dark:bg-white/[.04] cursor-default relative group"
                     data-cat="@a.Category"
                     style="animation-delay: @(cardIdx * 40)ms">
                    <!-- Top gradient strip -->
                    <div class="h-1.5 w-full"
                         style="background:linear-gradient(90deg,@a.GradientFrom,@a.GradientTo)"></div>

                    <div class="p-5">
                        <!-- Icon -->
                        <div class="relative mb-4 w-fit">
                            <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-lg relative overflow-hidden"
                                 style="background:linear-gradient(135deg,@a.GradientFrom,@a.GradientTo); @(isEarned ? "" : "filter:grayscale(1)")">
                                @a.Icon
                                @if (isEarned)
                                {
                                    <div class="badge-shine absolute inset-0"></div>
                                }
                            </div>
                            @if (isEarned)
                            {
                                <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-green-400
                                             border-2 border-white dark:border-[#111118]
                                             flex items-center justify-center">
                                    <span class="material-symbols-outlined text-white text-[10px]" style="font-variation-settings:'FILL' 1">check</span>
                                </div>
                            }
                            else
                            {
                                <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-gray-300 dark:bg-slate-600
                                             border-2 border-white dark:border-[#111118]
                                             flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-500 dark:text-slate-400 text-[10px]">lock</span>
                                </div>
                            }
                        </div>

                        <!-- Name & desc -->
                        <h3 class="font-bold text-gray-900 dark:text-white text-sm mb-1 leading-tight">@a.Name</h3>
                        <p class="text-gray-500 dark:text-slate-400 text-xs leading-relaxed @(isEarned ? "" : "blur-[2px] select-none")">
                            @(isEarned ? a.Description : "???")
                        </p>

                        <!-- Footer -->
                        <div class="flex items-center justify-between mt-4 pt-3
                                     border-t border-gray-100 dark:border-white/[.06]">
                            <!-- Category pill -->
                            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full"
                                  style="color:@a.GradientFrom; background-color:@(a.GradientFrom)28; border:1px solid @(a.GradientFrom)55;">
                                @a.Category
                            </span>

                            <!-- XP badge -->
                            <span class="text-xs font-bold px-2 py-0.5 rounded-full
                                          @(isEarned ? "bg-amber-400/15 text-amber-500" : "bg-gray-100 dark:bg-white/5 text-gray-400 dark:text-slate-500")">
                                +@a.XPValue XP
                            </span>
                        </div>

                        <!-- Earned date -->
                        @if (ua != null)
                        {
                            <p class="text-[10px] text-gray-400 dark:text-slate-500 mt-2 text-right">
                                Earned @ua.EarnedAt.ToString("MMM d, yyyy")
                            </p>
                        }
                    </div>
                </div>
                cardIdx++;
            }
        </div>

        @if (!all.Any())
        {
            <div class="text-center py-20 text-gray-400 dark:text-slate-500">
                <span class="material-symbols-outlined text-5xl mb-4 block">military_tech</span>
                <p class="text-lg font-semibold">No achievements found</p>
                <p class="text-sm mt-1">Check back after starting your first lesson.</p>
            </div>
        }

    </main>
</div>

<script>
function filterCat(cat) {
    // Update buttons
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    const activeBtn = document.getElementById(
        cat === 'all' ? 'cat-all' : 'cat-' + cat.toLowerCase().replace(/ /g,'-')
    );
    if (activeBtn) activeBtn.classList.add('active');

    // Filter cards
    document.querySelectorAll('#badge-grid > div[data-cat]').forEach(card => {
        const matches = cat === 'all' || card.dataset.cat === cat;
        card.style.display = matches ? '' : 'none';
    });
}
</script>
</body>
</html>
