@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Analytics & Reports";
    ViewData["Subtitle"] = "Real-time insights on student progress, engagement, and platform health.";
}

<div class="flex flex-col gap-6 max-w-[1400px] mx-auto">
<!-- Page Heading & Actions -->
<div class="flex flex-wrap items-end justify-between gap-4">
<div>
<h1 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight">Platform Analytics</h1>
<p class="text-slate-500 dark:text-slate-400 mt-1">Real-time insights on student progress, engagement, and platform health.</p>
</div>
</div>

<!-- KPI Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<!-- Stat Card 1 -->
<div class="flex flex-col p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
<div class="flex justify-between items-start mb-4 z-10">
<p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Active Learners</p>
<span class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-xs">trending_up</span> +5%
</span>
</div>
<div class="z-10">
<h3 class="text-3xl font-bold text-slate-900 dark:text-white">@ViewBag.ActiveUsers</h3>
<p class="text-slate-500 dark:text-slate-400 text-xs mt-1">out of @ViewBag.TotalUsers total users</p>
</div>
<div class="absolute -right-4 -bottom-4 bg-primary/5 rounded-full size-24 group-hover:scale-110 transition-transform duration-500"></div>
</div>
<!-- Stat Card 2 -->
<div class="flex flex-col p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
<div class="flex justify-between items-start mb-4 z-10">
<p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Total Courses</p>
<span class="bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-xs px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-xs">trending_up</span> +2%
</span>
</div>
<div class="z-10">
<h3 class="text-3xl font-bold text-slate-900 dark:text-white">@ViewBag.TotalCourses</h3>
<p class="text-slate-500 dark:text-slate-400 text-xs mt-1">@ViewBag.TotalLessons lessons available</p>
</div>
<div class="absolute -right-4 -bottom-4 bg-blue-500/5 rounded-full size-24 group-hover:scale-110 transition-transform duration-500"></div>
</div>
<!-- Stat Card 3 -->
<div class="flex flex-col p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
<div class="flex justify-between items-start mb-4 z-10">
<p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Coding Exercises</p>
<span class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-xs">trending_up</span> +12%
</span>
</div>
<div class="z-10">
<h3 class="text-3xl font-bold text-slate-900 dark:text-white">@ViewBag.TotalExercises</h3>
<p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Available exercises</p>
</div>
<div class="absolute -right-4 -bottom-4 bg-orange-500/5 rounded-full size-24 group-hover:scale-110 transition-transform duration-500"></div>
</div>
<!-- Stat Card 4 -->
<div class="flex flex-col p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
<div class="flex justify-between items-start mb-4 z-10">
<p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Job Offers</p>
<span class="bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 text-xs px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-xs">remove</span> 0%
</span>
</div>
<div class="z-10">
<h3 class="text-3xl font-bold text-slate-900 dark:text-white">@ViewBag.TotalJobOffers</h3>
<p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Active listings</p>
</div>
<div class="absolute -right-4 -bottom-4 bg-teal-500/5 rounded-full size-24 group-hover:scale-110 transition-transform duration-500"></div>
</div>
</div>

<!-- Main Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
<!-- User Progress Chart -->
<div class="lg:col-span-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark p-6 shadow-sm">
<div class="flex items-center justify-between mb-6">
<div>
<h3 class="text-lg font-bold text-slate-900 dark:text-white">User Progress Overview</h3>
<p class="text-sm text-slate-500 dark:text-slate-400">Completed lessons and exercises</p>
</div>
<button class="p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400">more_vert</span>
</button>
</div>
@{
    var usersWithProgress = ViewBag.UsersWithProgress as List<dynamic>;
    var totalCompletedLessons = usersWithProgress?.Sum(u => (int)(u.CompletedLessons ?? 0)) ?? 0;
    var totalCompletedExercises = usersWithProgress?.Sum(u => (int)(u.CompletedExercises ?? 0)) ?? 0;
    var totalQuizAttempts = usersWithProgress?.Sum(u => (int)(u.QuizAttempts ?? 0)) ?? 0;
    var totalPassedQuizzes = usersWithProgress?.Sum(u => (int)(u.PassedQuizzes ?? 0)) ?? 0;
}
<div class="h-[300px] w-full relative">
<!-- Simulated Chart -->
<svg class="w-full h-full overflow-visible" preserveaspectratio="none" viewbox="0 0 100 100">
<defs>
<lineargradient id="gradient-progress" x1="0%" x2="0%" y1="0%" y2="100%">
<stop offset="0%" style="stop-color:#9e47eb; stop-opacity:0.2"></stop>
<stop offset="100%" style="stop-color:#9e47eb; stop-opacity:0"></stop>
</lineargradient>
</defs>
<!-- Grid lines -->
<line stroke="#eee7f3" dark:stroke="#3d2a4a" stroke-width="0.5" vector-effect="non-scaling-stroke" x1="0" x2="100" y1="0" y2="0"></line>
<line stroke="#eee7f3" dark:stroke="#3d2a4a" stroke-width="0.5" vector-effect="non-scaling-stroke" x1="0" x2="100" y1="25" y2="25"></line>
<line stroke="#eee7f3" dark:stroke="#3d2a4a" stroke-width="0.5" vector-effect="non-scaling-stroke" x1="0" x2="100" y1="50" y2="50"></line>
<line stroke="#eee7f3" dark:stroke="#3d2a4a" stroke-width="0.5" vector-effect="non-scaling-stroke" x1="0" x2="100" y1="75" y2="75"></line>
<line stroke="#eee7f3" dark:stroke="#3d2a4a" stroke-width="0.5" vector-effect="non-scaling-stroke" x1="0" x2="100" y1="100" y2="100"></line>
<!-- Data line -->
<path d="M0,80 C10,70 15,90 25,60 C35,30 40,40 50,30 C60,20 65,35 75,25 C85,15 90,30 100,10" fill="none" stroke="#9e47eb" stroke-linecap="round" stroke-width="2.5" vector-effect="non-scaling-stroke"></path>
<path d="M0,80 C10,70 15,90 25,60 C35,30 40,40 50,30 C60,20 65,35 75,25 C85,15 90,30 100,10 V100 H0 Z" fill="url(#gradient-progress)" stroke="none"></path>
</svg>
</div>
<div class="mt-6 grid grid-cols-3 gap-4">
<div class="text-center">
<p class="text-2xl font-bold text-slate-900 dark:text-white">@totalCompletedLessons</p>
<p class="text-xs text-slate-500 dark:text-slate-400">Lessons Completed</p>
</div>
<div class="text-center">
<p class="text-2xl font-bold text-slate-900 dark:text-white">@totalCompletedExercises</p>
<p class="text-xs text-slate-500 dark:text-slate-400">Exercises Solved</p>
</div>
<div class="text-center">
<p class="text-2xl font-bold text-slate-900 dark:text-white">@totalPassedQuizzes</p>
<p class="text-xs text-slate-500 dark:text-slate-400">Quizzes Passed</p>
</div>
</div>
</div>

<!-- Course Distribution -->
<div class="lg:col-span-1 rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark p-6 shadow-sm flex flex-col">
<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Course Distribution</h3>
<p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Enrollment by course</p>
@{
    var courseEnrollments = ViewBag.CourseEnrollments as List<dynamic>;
    var totalEnrollments = courseEnrollments?.Sum(c => (int)(c.EnrollmentCount ?? 0)) ?? 0;
}
@if (courseEnrollments != null && courseEnrollments.Any())
{
    <div class="flex-1 flex flex-col justify-center gap-4">
    @foreach (var enrollment in courseEnrollments.Take(4))
    {
        var percentage = totalEnrollments > 0 ? (int)(((int)(enrollment.EnrollmentCount ?? 0) * 100.0) / totalEnrollments) : 0;
        <div>
        <div class="flex justify-between mb-2">
        <span class="text-sm font-medium text-slate-900 dark:text-white">@enrollment.CourseTitle</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">@enrollment.EnrollmentCount</span>
        </div>
        <div class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
        <div class="h-full bg-primary rounded-full transition-all" style="width: @percentage%"></div>
        </div>
        </div>
    }
    </div>
}
else
{
    <div class="flex-1 flex items-center justify-center">
    <p class="text-slate-500 dark:text-slate-400 text-sm">No enrollment data available</p>
    </div>
}
</div>
</div>

<!-- Second Row: Detailed Stats -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
<!-- Top Performing Users -->
<div class="bg-surface-light dark:bg-surface-dark rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
<div class="p-6 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
<div>
<h3 class="text-lg font-bold text-slate-900 dark:text-white">Top Performing Users</h3>
<p class="text-sm text-slate-500 dark:text-slate-400">Based on completed lessons and exercises</p>
</div>
<a asp-controller="Admin" asp-action="UserManagment" class="text-sm text-primary font-semibold hover:underline">View All</a>
</div>
<div class="p-0">
@if (usersWithProgress != null && usersWithProgress.Any())
{
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
    @foreach (var user in usersWithProgress.OrderByDescending(u => (int)(u.CompletedLessons ?? 0) + (int)(u.CompletedExercises ?? 0)).Take(5))
    {
        var totalProgress = (int)(user.CompletedLessons ?? 0) + (int)(user.CompletedExercises ?? 0);
        <div class="px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-primary">person</span>
        </div>
        <div>
        <p class="font-medium text-slate-900 dark:text-white">User @user.UserId.ToString().Substring(0, 8)</p>
        <p class="text-xs text-slate-500 dark:text-slate-400">@user.CompletedLessons lessons • @user.CompletedExercises exercises</p>
        </div>
        </div>
        <div class="text-right">
        <p class="text-sm font-bold text-slate-900 dark:text-white">@totalProgress</p>
        <p class="text-xs text-slate-500 dark:text-slate-400">Total</p>
        </div>
        </div>
        </div>
    }
    </div>
}
else
{
    <div class="px-6 py-12 text-center">
    <span class="material-symbols-outlined text-slate-400 text-4xl mb-2">bar_chart</span>
    <p class="text-slate-500 dark:text-slate-400">No user progress data available</p>
    </div>
}
</div>
</div>

<!-- Platform Statistics -->
<div class="bg-surface-light dark:bg-surface-dark rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm p-6">
<div class="flex justify-between items-center mb-6">
<div>
<h3 class="text-lg font-bold text-slate-900 dark:text-white">Platform Statistics</h3>
<p class="text-sm text-slate-500 dark:text-slate-400">Key metrics overview</p>
</div>
</div>
<div class="flex flex-col gap-5">
<!-- Stat Item 1 -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined">school</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<h4 class="text-sm font-semibold text-slate-900 dark:text-white">Total Lessons</h4>
<span class="text-sm font-bold text-slate-900 dark:text-white">@ViewBag.TotalLessons</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400">Available across all courses</p>
</div>
</div>
<!-- Stat Item 2 -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-lg bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined">code</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<h4 class="text-sm font-semibold text-slate-900 dark:text-white">Coding Exercises</h4>
<span class="text-sm font-bold text-slate-900 dark:text-white">@ViewBag.TotalExercises</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400">Hands-on practice opportunities</p>
</div>
</div>
<!-- Stat Item 3 -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-lg bg-green-50 dark:bg-green-900/30 text-green-600 dark:text-green-400 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined">quiz</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<h4 class="text-sm font-semibold text-slate-900 dark:text-white">Quiz Attempts</h4>
<span class="text-sm font-bold text-slate-900 dark:text-white">@totalQuizAttempts</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400">@totalPassedQuizzes passed successfully</p>
</div>
</div>
<!-- Stat Item 4 -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-lg bg-orange-50 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined">work</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<h4 class="text-sm font-semibold text-slate-900 dark:text-white">Job Offers</h4>
<span class="text-sm font-bold text-slate-900 dark:text-white">@ViewBag.TotalJobOffers</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400">Active job listings</p>
</div>
</div>
</div>
</div>
</div>
</div>

<!-- User-Submitted Reports Section -->
@{
    var userReports = ViewBag.UserReports as List<CodeWave.Domain.Entities.UserReport> ?? new List<CodeWave.Domain.Entities.UserReport>();
    var pendingCount = userReports.Count(r => r.Status == "Pending");
}
<div class="flex flex-col gap-4">
    <!-- Section Header -->
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">User Reports</h2>
            @if (pendingCount > 0)
            {
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-bold">
                    <span class="material-symbols-outlined text-xs">circle</span>
                    @pendingCount Pending
                </span>
            }
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400">Feedback and issues submitted by users</p>
    </div>

    @if (!userReports.Any())
    {
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark p-12 text-center">
            <span class="material-symbols-outlined text-5xl text-slate-300 dark:text-slate-600 block mb-3">inbox</span>
            <p class="text-slate-500 dark:text-slate-400 font-medium">No reports submitted yet</p>
            <p class="text-slate-400 dark:text-slate-500 text-sm mt-1">User-submitted reports will appear here</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark overflow-hidden shadow-sm">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">User</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Category</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Subject</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var report in userReports)
                    {
                        var statusClasses = report.Status switch {
                            "Pending"  => "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400",
                            "Reviewed" => "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400",
                            "Resolved" => "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400",
                            _          => "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300"
                        };
                        var catIcon = report.Category switch {
                            "Bug"                  => "bug_report",
                            "Content Issue"        => "article",
                            "Inappropriate Content"=> "flag",
                            "Suggestion"           => "lightbulb",
                            _                      => "report"
                        };
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors" x-data="{ open: false }">
                            <td class="px-4 py-3">
                                <p class="font-semibold text-slate-900 dark:text-white">@report.UserName</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">@report.UserEmail</p>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-slate-400" style="font-size:16px">@catIcon</span>
                                    <span class="text-slate-700 dark:text-slate-300">@report.Category</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 max-w-[220px]">
                                <button onclick="toggleReportDetail('detail-@report.Id')" class="text-left group">
                                    <p class="font-medium text-slate-900 dark:text-white truncate group-hover:text-primary transition-colors">@report.Subject</p>
                                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Click to expand</p>
                                </button>
                                <div id="detail-@report.Id" class="hidden mt-2 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-w-xs">
                                    @report.Description
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-500 dark:text-slate-400 whitespace-nowrap">
                                @report.SubmittedAt.ToString("MMM d, yyyy")
                                <p class="text-xs">@report.SubmittedAt.ToString("HH:mm") UTC</p>
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @statusClasses">@report.Status</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    @if (report.Status != "Reviewed")
                                    {
                                        <form asp-action="UpdateReportStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reportId" value="@report.Id" />
                                            <input type="hidden" name="status" value="Reviewed" />
                                            <button type="submit" title="Mark as Reviewed" class="p-1.5 rounded-lg text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
                                                <span class="material-symbols-outlined" style="font-size:18px">visibility</span>
                                            </button>
                                        </form>
                                    }
                                    @if (report.Status != "Resolved")
                                    {
                                        <form asp-action="UpdateReportStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reportId" value="@report.Id" />
                                            <input type="hidden" name="status" value="Resolved" />
                                            <button type="submit" title="Mark as Resolved" class="p-1.5 rounded-lg text-green-500 hover:bg-green-50 dark:hover:bg-green-900/20 transition-colors">
                                                <span class="material-symbols-outlined" style="font-size:18px">check_circle</span>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="DeleteReport" method="post" onsubmit="return confirm('Delete this report?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reportId" value="@report.Id" />
                                        <button type="submit" title="Delete" class="p-1.5 rounded-lg text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                                            <span class="material-symbols-outlined" style="font-size:18px">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Real Job Applications -->
@{
    var externalJobApps = ViewBag.ExternalJobApplications as List<object>;
    var totalExtApps    = (int)(ViewBag.TotalExternalApplications ?? 0);
}
<div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark shadow-sm overflow-hidden">
    <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-green-100 dark:bg-green-900/30 border border-green-200 dark:border-green-700">
                <span class="material-symbols-outlined text-green-600 dark:text-green-400 text-lg">travel_explore</span>
            </div>
            <div>
                <h3 class="font-bold text-slate-900 dark:text-white">Real Job Applications</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Self-reported applications to external job listings</p>
            </div>
        </div>
        <span class="px-3 py-1 rounded-full text-sm font-bold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-700">
            @totalExtApps total
        </span>
    </div>

    @if (externalJobApps == null || !externalJobApps.Any())
    {
        <div class="p-12 text-center text-slate-500 dark:text-slate-400">
            <span class="material-symbols-outlined text-4xl mb-3 block">work_off</span>
            <p class="font-medium">No external job applications yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">User</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Job Title</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Company</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Location</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Match</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Applied</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Link</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (dynamic app in externalJobApps)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                            <td class="px-4 py-3">
                                <p class="font-semibold text-slate-900 dark:text-white">@app.UserName</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">@app.UserEmail</p>
                            </td>
                            <td class="px-4 py-3 font-medium text-slate-800 dark:text-slate-200 max-w-[180px] truncate">@app.JobTitle</td>
                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@app.EmployerName</td>
                            <td class="px-4 py-3 text-slate-500 dark:text-slate-400 text-xs">@(string.IsNullOrEmpty((string)app.JobLocation) ? "—" : app.JobLocation)</td>
                            <td class="px-4 py-3">
                                @{
                                    double pct = (double)app.MatchPercentage;
                                    var pctCls = pct >= 80 ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400"
                                               : pct >= 60 ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400"
                                               : pct >= 40 ? "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400"
                                               : "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300";
                                }
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold @pctCls">@pct.ToString("0")%</span>
                            </td>
                            <td class="px-4 py-3 text-slate-500 dark:text-slate-400 whitespace-nowrap text-xs">
                                @((DateTime)app.AppliedDate).ToString("MMM d, yyyy")
                            </td>
                            <td class="px-4 py-3">
                                <a href="@app.ApplyLink" target="_blank" rel="noopener noreferrer"
                                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-800/40 transition-colors border border-green-200 dark:border-green-700">
                                    <span class="material-symbols-outlined" style="font-size:13px">open_in_new</span>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
function toggleReportDetail(id) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('hidden');
}
</script>
