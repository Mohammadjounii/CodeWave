@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Overview";
    ViewData["Subtitle"] = "Welcome back, here's what's happening today.";
}

<div class="flex flex-col gap-6 max-w-[1400px] mx-auto">
<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<!-- Card 1 -->
<div class="flex flex-col p-5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-center justify-between mb-4">
<div class="p-2 rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
<span class="material-symbols-outlined" style="font-size: 24px;">school</span>
</div>
</div>
<p class="text-text-sub-light dark:text-text-sub-dark text-sm font-medium">Total Learners</p>
<h3 class="text-2xl font-bold text-text-main-light dark:text-text-main-dark mt-1">@ViewBag.TotalUsers</h3>
<p class="text-xs text-text-sub-light dark:text-text-sub-dark mt-2">Registered users</p>
</div>
<!-- Card 2 -->
<div class="flex flex-col p-5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-center justify-between mb-4">
<div class="p-2 rounded-lg bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400">
<span class="material-symbols-outlined" style="font-size: 24px;">book_2</span>
</div>
</div>
<p class="text-text-sub-light dark:text-text-sub-dark text-sm font-medium">Active Courses</p>
<h3 class="text-2xl font-bold text-text-main-light dark:text-text-main-dark mt-1">@ViewBag.TotalCourses</h3>
<p class="text-xs text-text-sub-light dark:text-text-sub-dark mt-2">Available courses</p>
</div>
<!-- Card 3 -->
<div class="flex flex-col p-5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-center justify-between mb-4">
<div class="p-2 rounded-lg bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400">
<span class="material-symbols-outlined" style="font-size: 24px;">business_center</span>
</div>
</div>
<p class="text-text-sub-light dark:text-text-sub-dark text-sm font-medium">Job Offers</p>
<h3 class="text-2xl font-bold text-text-main-light dark:text-text-main-dark mt-1">@ViewBag.TotalJobOffers</h3>
<p class="text-xs text-text-sub-light dark:text-text-sub-dark mt-2">Active job listings</p>
</div>
<!-- Card 4 -->
<div class="flex flex-col p-5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-center justify-between mb-4">
<div class="p-2 rounded-lg bg-teal-100 text-teal-600 dark:bg-teal-900/30 dark:text-teal-400">
<span class="material-symbols-outlined" style="font-size: 24px;">send</span>
</div>
</div>
<p class="text-text-sub-light dark:text-text-sub-dark text-sm font-medium">Job Applications</p>
<h3 class="text-2xl font-bold text-text-main-light dark:text-text-main-dark mt-1">@ViewBag.TotalApplications</h3>
<p class="text-xs text-text-sub-light dark:text-text-sub-dark mt-2">Submitted by users</p>
</div>
</div>

<!-- Quick Actions -->
<div class="flex flex-wrap gap-3">
    <a href="@Url.Action("UserManagment", "Admin")"
       class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors shadow-sm">
        <span class="material-symbols-outlined text-blue-500" style="font-size:18px">manage_accounts</span>
        Manage Users
    </a>
    <a href="@Url.Action("Reports", "Admin")"
       class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors shadow-sm">
        <span class="material-symbols-outlined text-teal-500" style="font-size:18px">bar_chart</span>
        View Reports
    </a>
    <a href="@Url.Action("ExportUsers", "Admin")"
       class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors shadow-sm">
        <span class="material-symbols-outlined text-green-500" style="font-size:18px">download</span>
        Export CSV
    </a>
</div>

<!-- Main Chart Section -->
<div class="w-full">
<!-- Big Chart: User Engagement -->
<div class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-6 shadow-sm w-full">
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 w-full">
<div>
<h3 class="text-lg font-bold text-text-main-light dark:text-text-main-dark">User Engagement</h3>
<p class="text-sm text-text-sub-light dark:text-text-sub-dark">Active sessions over the last @(ViewBag.SelectedDays ?? 30) days</p>
</div>
<div class="flex items-center gap-2 p-1 bg-background-light dark:bg-background-dark rounded-lg border border-border-light dark:border-border-dark self-start sm:self-auto">
<a href="@Url.Action("Index", "Admin", new { days = 30 })" class="px-3 py-1 text-xs font-medium @((ViewBag.SelectedDays ?? 30) == 30 ? "bg-surface-light dark:bg-surface-dark text-primary shadow-sm" : "text-text-sub-light dark:text-text-sub-dark hover:text-text-main-light dark:hover:text-text-main-dark") rounded-md transition-all">30 Days</a>
<a href="@Url.Action("Index", "Admin", new { days = 7 })" class="px-3 py-1 text-xs font-medium @((ViewBag.SelectedDays ?? 30) == 7 ? "bg-surface-light dark:bg-surface-dark text-primary shadow-sm" : "text-text-sub-light dark:text-text-sub-dark hover:text-text-main-light dark:hover:text-text-main-dark") rounded-md transition-all">7 Days</a>
<a href="@Url.Action("Index", "Admin", new { days = 1 })" class="px-3 py-1 text-xs font-medium @((ViewBag.SelectedDays ?? 30) == 1 ? "bg-surface-light dark:bg-surface-dark text-primary shadow-sm" : "text-text-sub-light dark:text-text-sub-dark hover:text-text-main-light dark:hover:text-text-main-dark") rounded-md transition-all">24 Hours</a>
</div>
</div>
<div class="h-[300px] w-full relative">
<canvas id="engagementChart"></canvas>
</div>
</div>
</div>

<!-- Right Column: Stats & Distribution -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
<!-- Skill Distribution -->
<div class="flex-1 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-6 shadow-sm">
<h3 class="text-lg font-bold text-text-main-light dark:text-text-main-dark mb-4">Skill Distribution</h3>
<div class="h-[180px] w-full relative">
<canvas id="skillDistributionChart"></canvas>
</div>
</div>
<!-- Quick Stats List -->
<div class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-6 shadow-sm">
<h3 class="text-lg font-bold text-text-main-light dark:text-text-main-dark mb-4">Courses</h3>
<div class="flex flex-col gap-4 max-h-[300px] overflow-y-auto">
@{
    var topCourses = ViewBag.TopCourses as List<object>;
    if (topCourses != null && topCourses.Count > 0)
    {
        var colorClasses = new[] { 
            "bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400",
            "bg-yellow-100 text-yellow-600 dark:bg-yellow-900/30 dark:text-yellow-400",
            "bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400",
            "bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400",
            "bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400",
            "bg-indigo-100 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400"
        };
        var icons = new[] { "code", "terminal", "data_object", "school", "book", "menu_book" };
        
        @for (int i = 0; i < topCourses.Count; i++)
        {
            try
            {
                var course = (dynamic)topCourses[i];
                var courseTitle = course?.Title?.ToString() ?? "Unknown Course";
                var enrollmentCount = course?.EnrollmentCount?.ToString() ?? "0";
                var colorClass = colorClasses[i % colorClasses.Length];
                var icon = icons[i % icons.Length];
                
                <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                <div class="flex items-center justify-center size-8 rounded @colorClass">
                <span class="material-symbols-outlined" style="font-size: 18px;">@icon</span>
                </div>
                <span class="text-sm font-medium text-text-main-light dark:text-text-main-dark">@courseTitle</span>
                </div>
                <span class="text-sm font-bold text-text-main-light dark:text-text-main-dark">@enrollmentCount</span>
                </div>
            }
            catch
            {
                <div class="flex items-center justify-center py-2 text-text-sub-light dark:text-text-sub-dark text-xs">
                <p>Error loading course data</p>
                </div>
            }
        }
    }
    else
    {
        <div class="flex items-center justify-center py-4 text-text-sub-light dark:text-text-sub-dark text-sm">
        <p>No courses available</p>
        </div>
    }
}
</div>
</div>
</div>

<!-- Recent Users + Learning Path Distribution -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Recent Registrations (spans 2 columns) -->
    <div class="lg:col-span-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-surface-dark shadow-sm p-6">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Recent Registrations</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Last 10 users to join the platform</p>
            </div>
            <a href="@Url.Action("UserManagment", "Admin")" class="text-xs font-semibold text-primary hover:underline">View all →</a>
        </div>
        @{
            var recentUsers = ViewBag.RecentUsers as List<object>;
        }
        @if (recentUsers != null && recentUsers.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700">
                            <th class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400 pb-3 pr-4">User</th>
                            <th class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400 pb-3 pr-4">Learning Path</th>
                            <th class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400 pb-3 pr-4">Level</th>
                            <th class="text-left text-xs font-semibold text-slate-500 dark:text-slate-400 pb-3">Role</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">
                        @foreach (var userObj in recentUsers)
                        {
                            var u = (dynamic)userObj;
                            string firstName   = u?.FirstName?.ToString() ?? "";
                            string lastName    = u?.LastName?.ToString()  ?? "";
                            string email       = u?.Email?.ToString()     ?? "";
                            string path        = u?.LearningPath?.ToString() ?? "None";
                            string level       = u?.Level?.ToString()    ?? "New";
                            bool   isAdminUser = (bool)(u?.IsAdmin ?? false);

                            string fullName  = (firstName + " " + lastName).Trim();
                            string initials  = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "?";

                            string pathBadge = path.ToLower() switch {
                                "python"           => "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400",
                                "java"             => "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
                                "web development"  => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
                                _                  => "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300"
                            };
                            string levelBadge = level.ToLower() switch {
                                "beginner"     => "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
                                "intermediate" => "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400",
                                "advanced"     => "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400",
                                _              => "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400"
                            };

                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="py-3 pr-4">
                                    <div class="flex items-center gap-3">
                                        <div class="size-8 rounded-full bg-primary/15 flex items-center justify-center text-primary text-xs font-bold flex-shrink-0">@initials</div>
                                        <div class="min-w-0">
                                            <p class="font-semibold text-slate-900 dark:text-white text-xs truncate">@(fullName.Length > 0 ? fullName : "—")</p>
                                            <p class="text-slate-400 dark:text-slate-500 text-[10px] truncate">@email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 pr-4">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium @pathBadge whitespace-nowrap">@path</span>
                                </td>
                                <td class="py-3 pr-4">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium @levelBadge">@level</span>
                                </td>
                                <td class="py-3">
                                    @if (isAdminUser)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 dark:text-slate-500">User</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-10 gap-2 text-slate-400 dark:text-slate-500">
                <span class="material-symbols-outlined text-3xl">person_off</span>
                <p class="text-sm">No users registered yet.</p>
            </div>
        }
    </div>

    <!-- Learning Path Distribution -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-surface-dark shadow-sm p-6">
        <div class="mb-5">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Learning Paths</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">User distribution & engagement</p>
        </div>
        @{
            var pathDist = ViewBag.PathDistribution as List<object>;
        }
        @if (pathDist != null && pathDist.Count > 0)
        {
            <div class="flex flex-col gap-5">
                @foreach (var pathObj in pathDist)
                {
                    var pd = (dynamic)pathObj;
                    string pName    = pd?.Path?.ToString()    ?? "None";
                    int    pTotal   = (int)(pd?.Total   ?? 0);
                    int    pActive  = (int)(pd?.Active  ?? 0);
                    double pPct     = (double)(pd?.Percent ?? 0.0);
                    int    engRate  = pTotal > 0 ? (int)Math.Round(pActive / (double)pTotal * 100) : 0;

                    string bar = pName.ToLower() switch {
                        "python"          => "bg-purple-500",
                        "java"            => "bg-orange-500",
                        "web development" => "bg-blue-500",
                        _                 => "bg-slate-400"
                    };
                    string dot = pName.ToLower() switch {
                        "python"          => "bg-purple-500",
                        "java"            => "bg-orange-500",
                        "web development" => "bg-blue-500",
                        _                 => "bg-slate-400"
                    };

                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-2">
                                <div class="size-2 rounded-full @dot"></div>
                                <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">@pName</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-slate-500 dark:text-slate-400">@pTotal users</span>
                                <span class="text-xs font-bold text-slate-700 dark:text-slate-200">@pPct%</span>
                            </div>
                        </div>
                        <div class="w-full h-2 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
                            <div class="h-full @bar rounded-full" style="width:@pPct%"></div>
                        </div>
                        <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1">
                            @pActive active &bull; @engRate% engagement rate
                        </p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-10 gap-2 text-slate-400 dark:text-slate-500">
                <span class="material-symbols-outlined text-3xl">route</span>
                <p class="text-sm">No path data yet.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
@{
    var engagementData = ViewBag.EngagementData as List<object>;
    var labels = new List<string>();
    var sessionsData = new List<int>();
    var lessonCompletionsData = new List<int>();
    
    if (engagementData != null && engagementData.Count > 0)
    {
        foreach (var item in engagementData)
        {
            var point = (dynamic)item;
            labels.Add(point.Date);
            sessionsData.Add(point.Sessions);
            lessonCompletionsData.Add(point.LessonCompletions);
        }
    }
}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('engagementChart');
    if (!ctx) return;
    
    const isDarkMode = document.documentElement.classList.contains('dark');
    
    const chartData = {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
        datasets: [
            {
                label: 'Active Sessions',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sessionsData)),
                borderColor: '#9e47eb',
                backgroundColor: 'rgba(158, 71, 235, 0.1)',
                borderWidth: 2.5,
                fill: true,
                tension: 0.4,
                pointRadius: 3,
                pointHoverRadius: 5,
                pointBackgroundColor: '#9e47eb',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2
            },
            {
                label: 'Lesson Completions',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lessonCompletionsData)),
                borderColor: 'rgba(158, 71, 235, 0.5)',
                backgroundColor: 'rgba(158, 71, 235, 0.05)',
                borderWidth: 1.5,
                fill: false,
                tension: 0.4,
                pointRadius: 2,
                pointHoverRadius: 4,
                borderDash: [5, 5]
            }
        ]
    };
    
    const chartOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: @(engagementData != null && engagementData.Count > 0 ? "true" : "false"),
                position: 'top',
                labels: {
                    color: isDarkMode ? '#f8f9fc' : '#0d121b',
                    font: {
                        family: 'Inter, sans-serif',
                        size: 11
                    },
                    usePointStyle: true,
                    padding: 15
                }
            },
            tooltip: {
                backgroundColor: isDarkMode ? '#2d2438' : '#ffffff',
                titleColor: isDarkMode ? '#f8f9fc' : '#0d121b',
                bodyColor: isDarkMode ? '#f8f9fc' : '#0d121b',
                borderColor: isDarkMode ? '#3d2a4a' : '#eee7f3',
                borderWidth: 1,
                padding: 12,
                displayColors: true,
                callbacks: {
                    title: function(context) {
                        return context[0].label;
                    },
                    label: function(context) {
                        return context.dataset.label + ': ' + context.parsed.y + ' users';
                    }
                }
            }
        },
        scales: {
            x: {
                grid: {
                    color: isDarkMode ? 'rgba(61, 42, 74, 0.5)' : 'rgba(238, 231, 243, 0.5)',
                    drawBorder: false
                },
                ticks: {
                    color: isDarkMode ? '#9ca3af' : '#6b7280',
                    font: {
                        family: 'Inter, sans-serif',
                        size: 10
                    },
                    maxRotation: 45,
                    minRotation: 0
                }
            },
            y: {
                beginAtZero: true,
                grid: {
                    color: isDarkMode ? 'rgba(61, 42, 74, 0.5)' : 'rgba(238, 231, 243, 0.5)',
                    drawBorder: false
                },
                ticks: {
                    color: isDarkMode ? '#9ca3af' : '#6b7280',
                    font: {
                        family: 'Inter, sans-serif',
                        size: 10
                    },
                    precision: 0
                }
            }
        },
        interaction: {
            intersect: false,
            mode: 'index'
        }
    };
    
    const chart = new Chart(ctx, {
        type: 'line',
        data: chartData,
        options: chartOptions
    });
    
    // Skill Distribution Chart
    @{
        var skillDist = ViewBag.SkillDistribution as Dictionary<string, double>;
        var skillLabels = new List<string>();
        var skillData = new List<double>();
        
        if (skillDist != null)
        {
            skillLabels.Add("Beginner");
            skillLabels.Add("Intermediate");
            skillLabels.Add("Advanced");
            
            skillData.Add(skillDist.ContainsKey("Beginner") ? skillDist["Beginner"] : 0);
            skillData.Add(skillDist.ContainsKey("Intermediate") ? skillDist["Intermediate"] : 0);
            skillData.Add(skillDist.ContainsKey("Advanced") ? skillDist["Advanced"] : 0);
        }
    }
    
    const skillCtx = document.getElementById('skillDistributionChart');
    if (skillCtx) {
        const skillChartData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skillLabels)),
            datasets: [{
                label: 'Users (%)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skillData)),
                backgroundColor: [
                    'rgba(158, 71, 235, 0.8)',
                    'rgba(158, 71, 235, 1)',
                    'rgba(158, 71, 235, 0.6)'
                ],
                borderColor: [
                    '#9e47eb',
                    '#9e47eb',
                    '#9e47eb'
                ],
                borderWidth: 2,
                borderRadius: 8,
                borderSkipped: false
            }]
        };
        
        const skillChartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: isDarkMode ? '#2d2438' : '#ffffff',
                    titleColor: isDarkMode ? '#f8f9fc' : '#0d121b',
                    bodyColor: isDarkMode ? '#f8f9fc' : '#0d121b',
                    borderColor: isDarkMode ? '#3d2a4a' : '#eee7f3',
                    borderWidth: 1,
                    padding: 12,
                    displayColors: true,
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed.y.toFixed(1) + '%';
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false,
                        drawBorder: false
                    },
                    ticks: {
                        color: isDarkMode ? '#9ca3af' : '#6b7280',
                        font: {
                            family: 'Inter, sans-serif',
                            size: 10,
                            weight: 'bold'
                        }
                    }
                },
                y: {
                    beginAtZero: true,
                    max: 100,
                    grid: {
                        color: isDarkMode ? 'rgba(61, 42, 74, 0.5)' : 'rgba(238, 231, 243, 0.5)',
                        drawBorder: false
                    },
                    ticks: {
                        color: isDarkMode ? '#9ca3af' : '#6b7280',
                        font: {
                            family: 'Inter, sans-serif',
                            size: 10
                        },
                        callback: function(value) {
                            return value + '%';
                        }
                    }
                }
            }
        };
        
        new Chart(skillCtx, {
            type: 'bar',
            data: skillChartData,
            options: skillChartOptions
        });
    }
});
</script>
}
</div>