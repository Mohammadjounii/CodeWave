@model CodeWave.Web.Models.ChangePasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // Initialize theme immediately to prevent flash
        (function() {
            try {
                const html = document.documentElement;
                const savedTheme = localStorage.getItem('theme');
                const theme = savedTheme || 'dark';
                if (theme === 'dark') {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }
            } catch(e) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings - CodeWave</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: rgba(155,89,245,0.08); border-radius: 999px; }
        ::-webkit-scrollbar-thumb { background: #9b59f5; border-radius: 999px; box-shadow: 0 0 10px rgba(155,89,245,0.9), 0 0 20px rgba(155,89,245,0.5), 0 0 35px rgba(155,89,245,0.2); }
        ::-webkit-scrollbar-thumb:hover { background: #b07eff; box-shadow: 0 0 14px rgba(176,126,255,1), 0 0 28px rgba(176,126,255,0.6), 0 0 45px rgba(155,89,245,0.3); }
        ::-webkit-scrollbar-corner { background: transparent; }
        * { scrollbar-width: thin; scrollbar-color: #9b59f5 rgba(155,89,245,0.08); }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b887e3",
                        "background-light": "#f7f6f8",
                        "background-dark": "#19131f"
                    },
                    fontFamily: {
                        display: "Space Grotesk"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-white dark:bg-background-dark font-display text-gray-900 dark:text-slate-200">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        @await Html.PartialAsync("_UserSidebar")

            <!-- Main Content -->
            <main class="flex-1 p-8">
                <div class="max-w-3xl mx-auto">
                    <!-- Header -->
                    <div class="mb-8">
                        <h1 class="text-gray-900 dark:text-white text-4xl font-black mb-2">Settings</h1>
                        <p class="text-gray-600 dark:text-[#9da6b9]">Manage your account settings and security</p>
                    </div>

                    <!-- Success/Error Messages -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="mb-6 p-4 bg-green-100 dark:bg-green-900/50 border border-green-300 dark:border-green-700 rounded-lg text-green-800 dark:text-green-300">
                            @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="mb-6 p-4 bg-red-100 dark:bg-red-900/50 border border-red-300 dark:border-red-700 rounded-lg text-red-800 dark:text-red-300">
                            @TempData["Error"]
                        </div>
                    }

                    <!-- Change Password Section -->
                    <div class="bg-gray-100 dark:bg-[#111318] border border-gray-300 dark:border-[#3b4354] rounded-xl p-6 mb-6">
                        <h2 class="text-gray-900 dark:text-white text-2xl font-bold mb-4">Change Password</h2>
                        <p class="text-gray-600 dark:text-[#9da6b9] mb-6">Update your password to keep your account secure.</p>
                        
                        <form asp-controller="Settings" asp-action="ChangePassword" method="post" class="space-y-4">
                            @Html.AntiForgeryToken()
                            
                            <div>
                                <label asp-for="CurrentPassword" class="block text-gray-900 dark:text-white text-sm font-medium mb-2">Current Password</label>
                                <input asp-for="CurrentPassword" type="password" class="w-full px-4 py-3 bg-white dark:bg-[#1c1f27] border border-gray-300 dark:border-[#3b4354] rounded-lg text-gray-900 dark:text-white focus:outline-none focus:border-primary" placeholder="Enter your current password" />
                                <span asp-validation-for="CurrentPassword" class="text-red-400 text-sm"></span>
                            </div>

                            <div>
                                <label asp-for="NewPassword" class="block text-gray-900 dark:text-white text-sm font-medium mb-2">New Password</label>
                                <input asp-for="NewPassword" type="password" class="w-full px-4 py-3 bg-white dark:bg-[#1c1f27] border border-gray-300 dark:border-[#3b4354] rounded-lg text-gray-900 dark:text-white focus:outline-none focus:border-primary" placeholder="Enter your new password" />
                                <span asp-validation-for="NewPassword" class="text-red-400 text-sm"></span>
                            </div>

                            <div>
                                <label asp-for="ConfirmNewPassword" class="block text-gray-900 dark:text-white text-sm font-medium mb-2">Confirm New Password</label>
                                <input asp-for="ConfirmNewPassword" type="password" class="w-full px-4 py-3 bg-white dark:bg-[#1c1f27] border border-gray-300 dark:border-[#3b4354] rounded-lg text-gray-900 dark:text-white focus:outline-none focus:border-primary" placeholder="Confirm your new password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-red-400 text-sm"></span>
                            </div>

                            @if (TempData["PasswordError"] != null)
                            {
                                <p class="text-red-400 text-sm">@TempData["PasswordError"]</p>
                            }

                            <button type="submit" class="w-full bg-primary text-white h-12 px-4 rounded-lg hover:bg-primary/90 font-medium">
                                Change Password
                            </button>
                        </form>
                    </div>

                    <!-- Switch Learning Path Section -->
                    <div class="bg-gray-100 dark:bg-[#111318] border border-gray-300 dark:border-[#3b4354] rounded-xl p-6 mb-6">
                        <h2 class="text-gray-900 dark:text-white text-2xl font-bold mb-2">Learning Path</h2>
                        <p class="text-gray-600 dark:text-[#9da6b9] mb-6">
                            Currently on: <span class="font-semibold text-primary">@(ViewBag.LearningPath ?? "Not set")</span>
                        </p>

                        <form asp-controller="Settings" asp-action="SwitchLearningPath" method="post">
                            @Html.AntiForgeryToken()
                            @{ var currentPath = ViewBag.LearningPath as string ?? ""; }
                            <div class="grid grid-cols-2 gap-4 mb-5">

                                @* Python card — hidden when current path is Python *@
                                @if (!string.Equals(currentPath, "Python", StringComparison.OrdinalIgnoreCase))
                                {
                                    <label class="cursor-pointer">
                                        <input type="radio" name="learningPath" value="Python" class="sr-only peer" />
                                        <div class="flex flex-col items-center gap-3 p-5 rounded-xl border-2
                                                    border-gray-300 dark:border-[#3b4354]
                                                    peer-checked:border-primary peer-checked:bg-primary/10
                                                    hover:border-primary/50 transition-all">
                                            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#5b21b6,#2e1065);display:flex;align-items:center;justify-content:center;box-shadow:0 0 18px rgba(167,139,250,.45);">
                                                <span class="material-symbols-outlined" style="font-size:28px;color:white;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;">terminal</span>
                                            </div>
                                            <span class="font-bold text-gray-900 dark:text-white">Python</span>
                                            <span class="text-xs text-center text-gray-500 dark:text-[#9da6b9]">Beginner-friendly, data science, automation</span>
                                        </div>
                                    </label>
                                }

                                @* Java card — hidden when current path is Java *@
                                @if (!string.Equals(currentPath, "Java", StringComparison.OrdinalIgnoreCase))
                                {
                                    <label class="cursor-pointer">
                                        <input type="radio" name="learningPath" value="Java" class="sr-only peer" />
                                        <div class="flex flex-col items-center gap-3 p-5 rounded-xl border-2
                                                    border-gray-300 dark:border-[#3b4354]
                                                    peer-checked:border-primary peer-checked:bg-primary/10
                                                    hover:border-primary/50 transition-all">
                                            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#c2410c,#7c2d12);display:flex;align-items:center;justify-content:center;box-shadow:0 0 18px rgba(251,146,60,.45);">
                                                <span class="material-symbols-outlined" style="font-size:28px;color:white;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;">coffee</span>
                                            </div>
                                            <span class="font-bold text-gray-900 dark:text-white">Java</span>
                                            <span class="text-xs text-center text-gray-500 dark:text-[#9da6b9]">Enterprise apps, Android, backend systems</span>
                                        </div>
                                    </label>
                                }

                                @* Web Development card — hidden when current path is Web Development *@
                                @if (!string.Equals(currentPath, "Web Development", StringComparison.OrdinalIgnoreCase))
                                {
                                    <label class="cursor-pointer">
                                        <input type="radio" name="learningPath" value="Web Development" class="sr-only peer" />
                                        <div class="flex flex-col items-center gap-3 p-5 rounded-xl border-2
                                                    border-gray-300 dark:border-[#3b4354]
                                                    peer-checked:border-primary peer-checked:bg-primary/10
                                                    hover:border-primary/50 transition-all">
                                            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#0e7490,#164e63);display:flex;align-items:center;justify-content:center;box-shadow:0 0 18px rgba(34,211,238,.45);">
                                                <span class="material-symbols-outlined" style="font-size:28px;color:white;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;">language</span>
                                            </div>
                                            <span class="font-bold text-gray-900 dark:text-white">Web Dev</span>
                                            <span class="text-xs text-center text-gray-500 dark:text-[#9da6b9]">HTML, CSS, JS, frontend & backend</span>
                                        </div>
                                    </label>
                                }
                            </div>

                            <button type="submit"
                                    class="w-full bg-primary text-white h-12 px-4 rounded-lg hover:bg-primary/90 font-medium flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-sm">swap_horiz</span>
                                Switch Learning Path
                            </button>
                        </form>
                    </div>

                    <!-- Skill Assessment Section -->
                    <div class="bg-gray-100 dark:bg-[#111318] border border-gray-300 dark:border-[#3b4354] rounded-xl p-6 mb-6">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <h2 class="text-gray-900 dark:text-white text-2xl font-bold mb-2">Skill Assessment</h2>
                                <p class="text-gray-600 dark:text-[#9da6b9] mb-1">
                                    Current level: <span class="font-semibold text-primary">@(ViewBag.UserLevelRaw ?? "Not set")</span>
                                </p>
                                <p class="text-gray-500 dark:text-[#9da6b9] text-sm">
                                    Retake the assessment to update your skill level. Your result will determine whether you're placed as Beginner or Advanced, which affects access to Job Opportunities and CV sections.
                                </p>
                            </div>
                        </div>
                        <button onclick="document.getElementById('retakeModal').classList.remove('hidden')"
                                class="mt-5 inline-flex items-center gap-2 bg-primary text-white h-12 px-6 rounded-lg hover:bg-primary/90 font-medium transition-colors">
                            <span class="material-symbols-outlined">quiz</span>
                            <span>Retake Assessment</span>
                        </button>
                    </div>

                    <!-- Forgot Password Section -->
                    <div class="bg-gray-100 dark:bg-[#111318] border border-gray-300 dark:border-[#3b4354] rounded-xl p-6 mb-6">
                        <h2 class="text-gray-900 dark:text-white text-2xl font-bold mb-4">Forgot Password?</h2>
                        <p class="text-gray-600 dark:text-[#9da6b9] mb-6">If you've forgotten your password, you can reset it using your email address.</p>

                        <a asp-controller="Settings" asp-action="ForgotPassword" class="inline-flex items-center gap-2 bg-gray-100 dark:bg-white/10 text-gray-900 dark:text-white h-12 px-6 rounded-lg hover:bg-gray-200 dark:hover:bg-white/20 font-medium">
                            <span class="material-symbols-outlined">lock_reset</span>
                            <span>Reset Password via Email</span>
                        </a>
                    </div>

                    <!-- Report an Issue Section -->
                    <div class="relative overflow-hidden rounded-2xl border border-primary/30 dark:border-primary/20" style="background: linear-gradient(135deg, #f5f0ff 0%, #fdf4ff 50%, #f0f4ff 100%);" >
                        <div class="dark:hidden absolute inset-0 rounded-2xl" style="background: linear-gradient(135deg, #f5f0ff 0%, #fdf4ff 50%, #f0f4ff 100%);"></div>
                        <div class="hidden dark:block absolute inset-0 rounded-2xl" style="background: linear-gradient(135deg, #1a1030 0%, #1e1535 50%, #161228 100%);"></div>

                        <!-- Decorative blobs -->
                        <div class="absolute top-0 right-0 w-64 h-64 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(184,135,227,0.18) 0%, transparent 70%); transform: translate(30%, -30%);"></div>
                        <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(139,92,246,0.12) 0%, transparent 70%); transform: translate(-30%, 30%);"></div>

                        <div class="relative z-10 p-8">
                            <!-- Header -->
                            <div class="flex items-center gap-4 mb-2">
                                <div class="flex items-center justify-center w-12 h-12 rounded-2xl shadow-lg" style="background: linear-gradient(135deg, #b887e3, #7c3aed);">
                                    <span class="material-symbols-outlined text-white" style="font-size:24px; font-variation-settings:'FILL' 1">flag</span>
                                </div>
                                <div>
                                    <h2 class="text-gray-900 dark:text-white text-2xl font-bold leading-tight">Report an Issue</h2>
                                    <p class="text-primary text-xs font-semibold tracking-wide uppercase">We read every report</p>
                                </div>
                            </div>
                            <p class="text-gray-500 dark:text-[#9da6b9] text-sm mb-7 ml-16">
                                Something not working the way you expected? Want a feature changed or improved? Tell us — your feedback shapes the platform.
                            </p>

                            @if (TempData["ReportSuccess"] != null)
                            {
                                <div class="mb-6 p-4 rounded-xl border border-green-300 dark:border-green-700/60 bg-green-50 dark:bg-green-900/20 flex items-center gap-3">
                                    <span class="material-symbols-outlined text-green-500" style="font-size:22px; font-variation-settings:'FILL' 1">check_circle</span>
                                    <p class="text-green-800 dark:text-green-300 text-sm font-medium">@TempData["ReportSuccess"]</p>
                                </div>
                            }
                            @if (TempData["ReportError"] != null)
                            {
                                <div class="mb-6 p-4 rounded-xl border border-red-300 dark:border-red-700/60 bg-red-50 dark:bg-red-900/20 flex items-center gap-3">
                                    <span class="material-symbols-outlined text-red-500" style="font-size:22px; font-variation-settings:'FILL' 1">error</span>
                                    <p class="text-red-800 dark:text-red-300 text-sm font-medium">@TempData["ReportError"]</p>
                                </div>
                            }

                            <form asp-controller="Settings" asp-action="SubmitReport" method="post" class="space-y-5">
                                @Html.AntiForgeryToken()

                                <!-- Category chips -->
                                <div>
                                    <label class="block text-gray-700 dark:text-slate-300 text-sm font-semibold mb-3">What type of report is this?</label>
                                    <div class="flex flex-wrap gap-2" id="categoryChips">
                                        @foreach (var cat in new[] {
                                            ("Bug", "bug_report", "#ef4444"),
                                            ("Feature Request", "lightbulb", "#f59e0b"),
                                            ("UI/UX Issue", "palette", "#3b82f6"),
                                            ("Content Issue", "article", "#10b981"),
                                            ("Other", "more_horiz", "#8b5cf6")
                                        })
                                        {
                                            <label class="cursor-pointer">
                                                <input type="radio" name="category" value="@cat.Item1" class="sr-only peer" @(cat.Item1 == "Bug" ? "checked" : "") />
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border-2 transition-all
                                                    border-gray-200 dark:border-[#3b4354] text-gray-600 dark:text-slate-400 bg-white dark:bg-[#1c1f27]
                                                    peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary dark:peer-checked:text-primary
                                                    hover:border-primary/50 select-none">
                                                    <span class="material-symbols-outlined" style="font-size:14px; font-variation-settings:'FILL' 1">@cat.Item2</span>
                                                    @cat.Item1
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </div>

                                <!-- Subject -->
                                <div>
                                    <label class="block text-gray-700 dark:text-slate-300 text-sm font-semibold mb-2">
                                        Subject <span class="text-primary">*</span>
                                    </label>
                                    <input type="text" name="subject" required maxlength="150"
                                        placeholder="Brief summary — e.g. Dark mode toggle doesn't save"
                                        class="w-full px-4 py-3 bg-white/80 dark:bg-[#1c1f27] border-2 border-gray-200 dark:border-[#3b4354] rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-[#9da6b9] focus:outline-none focus:border-primary dark:focus:border-primary transition-colors text-sm" />
                                </div>

                                <!-- Description -->
                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <label class="block text-gray-700 dark:text-slate-300 text-sm font-semibold">
                                            Description <span class="text-primary">*</span>
                                        </label>
                                        <span class="text-xs text-gray-400 dark:text-[#9da6b9]" id="charCount">0 / 1000</span>
                                    </div>
                                    <textarea name="description" id="reportDescription" required rows="5" maxlength="1000"
                                        placeholder="Describe the issue in detail. What did you expect? What happened instead? Steps to reproduce if applicable."
                                        class="w-full px-4 py-3 bg-white/80 dark:bg-[#1c1f27] border-2 border-gray-200 dark:border-[#3b4354] rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-[#9da6b9] focus:outline-none focus:border-primary dark:focus:border-primary transition-colors resize-none text-sm leading-relaxed"></textarea>
                                </div>

                                <!-- Submit -->
                                <div class="flex items-center gap-4 pt-1">
                                    <button type="submit"
                                        class="inline-flex items-center gap-2 text-white h-12 px-8 rounded-xl font-semibold transition-all hover:opacity-90 hover:-translate-y-0.5 shadow-lg shadow-primary/30"
                                        style="background: linear-gradient(135deg, #b887e3, #7c3aed);">
                                        <span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1">send</span>
                                        Submit Report
                                    </button>
                                    <p class="text-xs text-gray-400 dark:text-[#9da6b9]">Your name and email will be included so we can follow up.</p>
                                </div>
                            </form>
                        </div>
                    </div>

                    <script>
                        const desc = document.getElementById('reportDescription');
                        const counter = document.getElementById('charCount');
                        if (desc && counter) {
                            desc.addEventListener('input', () => {
                                counter.textContent = desc.value.length + ' / 1000';
                                counter.style.color = desc.value.length > 900 ? '#ef4444' : '';
                            });
                        }
                    </script>
                    </div>
                </div>
            </main>

    <!-- Retake Assessment Confirmation Modal -->
    <div id="retakeModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-[#1c1f27] border border-gray-200 dark:border-[#3b4354] rounded-2xl p-8 max-w-md w-full shadow-2xl">
            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 48;">quiz</span>
                <h3 class="text-gray-900 dark:text-white text-xl font-bold">Retake Assessment?</h3>
            </div>
            <p class="text-gray-600 dark:text-[#9da6b9] mb-2 text-sm leading-relaxed">
                You're about to retake the skill assessment. Your current level (<strong class="text-gray-900 dark:text-white">@(ViewBag.UserLevelRaw ?? "Not set")</strong>) will be replaced by your new score:
            </p>
            <ul class="text-sm text-gray-500 dark:text-[#9da6b9] list-disc list-inside mb-6 space-y-1">
                <li>Score <strong class="text-white">≥ 70%</strong> → Advanced level (full access)</li>
                <li>Score <strong class="text-white">&lt; 70%</strong> → Beginner level (restricted access)</li>
            </ul>
            <div class="flex gap-3">
                <button onclick="document.getElementById('retakeModal').classList.add('hidden')"
                        class="flex-1 h-12 rounded-lg border border-gray-300 dark:border-[#3b4354] text-gray-700 dark:text-slate-300 font-medium hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">
                    Cancel
                </button>
                <a href="@Url.Action("Start", "Assessment")"
                   class="flex-1 h-12 rounded-lg bg-primary text-white font-bold flex items-center justify-center gap-2 hover:bg-primary/90 transition-colors">
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    Start Now
                </a>
            </div>
        </div>
    </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

