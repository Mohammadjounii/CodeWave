@using CodeWave.Application.DTOs
@model List<QuizDto>
@{
    Layout = null;
    var attempts = ViewBag.QuizAttempts as List<QuizAttemptDto> ?? new List<QuizAttemptDto>();

    var javaQuizzes   = Model.Where(q => q.ProgrammingLanguage == "Java").ToList();
    var pythonQuizzes = Model.Where(q => q.ProgrammingLanguage == "Python").ToList();
    var webQuizzes    = Model.Where(q => q.ProgrammingLanguage == "WebDevelopment").ToList();

    var lp = (ViewBag.LearningPath as string ?? "").ToLower();
    var defaultTab = lp.Contains("python") ? "python" : lp.Contains("web") ? "web" : "java";
    var pathQuizzes = defaultTab == "python" ? pythonQuizzes : defaultTab == "web" ? webQuizzes : javaQuizzes;

    var totalAttempts  = attempts.Count;
    var passedAttempts = attempts.Count(a => a.IsPassed == true);
    var avgScore  = attempts.Where(a => a.Score.HasValue).Any() ? attempts.Where(a => a.Score.HasValue).Average(a => a.Score.Value) : 0;
    var bestScore = attempts.Where(a => a.Score.HasValue).Any() ? attempts.Where(a => a.Score.HasValue).Max(a => a.Score.Value) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    @await Html.PartialAsync("_ThemeScript")
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quizzes — CodeWave</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b887e3",
                        "primary-light": "#d4b5f0",
                        "primary-dark": "#9d6fd9",
                        "background-dark": "#05080f"
                    },
                    fontFamily: {
                        display: ["Space Grotesk", "Inter", "sans-serif"],
                        sans: ["Inter", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <style>
        :root {
            --green:        #34D399;
            --green-dim:    rgba(52,211,153,0.12);
            --green-border: rgba(52,211,153,0.3);
            --green-glow:   0 0 24px rgba(52,211,153,0.2);
            --java-color:   #A855F7;
            --java-dim:     rgba(168,85,247,0.12);
            --java-border:  rgba(168,85,247,0.35);
            --py-color:     #3B82F6;
            --py-dim:       rgba(59,130,246,0.12);
            --py-border:    rgba(59,130,246,0.35);
            --web-color:    #F97316;
            --web-dim:      rgba(249,115,22,0.12);
            --web-border:   rgba(249,115,22,0.35);
            --bg:           #05080f;
            --bg2:          #090c16;
            --bg3:          #0d1120;
            --border:       rgba(255,255,255,0.06);
            --border2:      rgba(255,255,255,0.1);
            --text:         #e2e8f0;
            --text-dim:     #6b7280;
        }

        /* Scope box-model reset only to quiz content, not the Tailwind sidebar */
        .qmain *, .qmain *::before, .qmain *::after { box-sizing: border-box; }

        body {
            background: var(--bg);
            -webkit-font-smoothing: antialiased;
        }

        .qmain {
            flex: 1;
            overflow-y: auto;
            padding: 32px 40px 60px;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            min-height: 100vh;
            background: var(--bg);
        }

        @@media (max-width: 768px) { .qmain { padding: 20px 16px 60px; } }

        /* ── Page header ── */
        .page-header { margin-bottom: 36px; }
        .page-header h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 700;
            background: linear-gradient(135deg, #fff 30%, var(--green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.2;
        }
        .page-header p { color: var(--text-dim); margin-top: 8px; font-size: 1rem; }

        /* ── Stat strip ── */
        .stat-strip {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
            margin-bottom: 40px;
        }
        .stat-card {
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: border-color .3s, transform .3s;
        }
        .stat-card:hover { border-color: var(--border2); transform: translateY(-3px); }
        .stat-icon {
            width: 46px; height: 46px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .stat-icon .material-symbols-outlined { font-size: 22px; }
        .stat-num  { font-size: 1.7rem; font-weight: 700; color: #fff; line-height: 1; }
        .stat-lbl  { font-size: .75rem; color: var(--text-dim); margin-top: 4px; text-transform: uppercase; letter-spacing: .05em; }

        .si-purple { background: rgba(139,92,246,.15); color: #a78bfa; }
        .si-green  { background: rgba(52,211,153,.15);  color: var(--green); }
        .si-blue   { background: rgba(59,130,246,.15);  color: #60a5fa; }
        .si-yellow { background: rgba(234,179,8,.15);   color: #fbbf24; }

        /* ── Language tabs ── */
        .lang-tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }
        .lang-btn {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 28px;
            border-radius: 50px;
            border: 1.5px solid var(--border2);
            background: var(--bg3);
            color: var(--text-dim);
            font-size: .95rem;
            font-weight: 600;
            font-family: 'Space Grotesk', sans-serif;
            cursor: pointer;
            transition: all .3s cubic-bezier(.4,0,.2,1);
            overflow: hidden;
        }
        .lang-btn::before {
            content: '';
            position: absolute; inset: 0;
            opacity: 0;
            transition: opacity .3s;
            border-radius: inherit;
        }
        .lang-btn:hover { color: #fff; border-color: var(--border2); }
        .lang-btn .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px; height: 22px;
            border-radius: 50%;
            font-size: .7rem;
            font-weight: 700;
            background: rgba(255,255,255,.1);
            color: inherit;
            transition: background .3s;
        }

        /* Java active */
        .lang-btn.java-btn.active,
        .lang-btn.java-btn:hover {
            border-color: var(--java-border);
            color: var(--java-color);
            box-shadow: 0 0 20px rgba(168,85,247,.15), inset 0 0 20px rgba(168,85,247,.05);
        }
        .lang-btn.java-btn.active .badge { background: var(--java-dim); }
        .lang-btn.java-btn .lang-dot { background: var(--java-color); }

        /* Python active */
        .lang-btn.py-btn.active,
        .lang-btn.py-btn:hover {
            border-color: var(--py-border);
            color: var(--py-color);
            box-shadow: 0 0 20px rgba(59,130,246,.15), inset 0 0 20px rgba(59,130,246,.05);
        }
        .lang-btn.py-btn.active .badge { background: var(--py-dim); }
        .lang-btn.py-btn .lang-dot { background: var(--py-color); }

        /* Web active */
        .lang-btn.web-btn.active,
        .lang-btn.web-btn:hover {
            border-color: var(--web-border);
            color: var(--web-color);
            box-shadow: 0 0 20px rgba(249,115,22,.15), inset 0 0 20px rgba(249,115,22,.05);
        }
        .lang-btn.web-btn.active .badge { background: var(--web-dim); }
        .lang-btn.web-btn .lang-dot { background: var(--web-color); }
        .icon-web  { background: var(--web-dim); color: var(--web-color); }
        .pill-web  { background: var(--web-dim); color: var(--web-color); border: 1px solid var(--web-border); }
        .quiz-card.web-card:hover { border-color: var(--web-border); box-shadow: 0 8px 32px rgba(249,115,22,.1); }
        .btn-web {
            background: linear-gradient(135deg, var(--web-color), #fb923c);
            color: #fff;
            box-shadow: 0 4px 16px rgba(249,115,22,.2);
        }
        .btn-web:hover {
            background: linear-gradient(135deg, #fb923c, var(--web-color));
            box-shadow: 0 6px 24px rgba(249,115,22,.35);
            transform: translateY(-1px);
        }

        .lang-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ── Quiz panel ── */
        .quiz-panel { display: none; }
        .quiz-panel.active { display: block; }

        .panel-label {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }
        .panel-label h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: #fff;
        }
        .panel-label .pill {
            padding: 3px 12px;
            border-radius: 50px;
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .04em;
        }
        .pill-java { background: var(--java-dim); color: var(--java-color); border: 1px solid var(--java-border); }
        .pill-py   { background: var(--py-dim);   color: var(--py-color);   border: 1px solid var(--py-border);   }

        /* ── Quiz grid ── */
        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 20px;
        }

        /* ── Quiz card ── */
        .quiz-card {
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            transition: border-color .3s, transform .3s, box-shadow .3s;
            animation: cardIn .4s ease both;
        }
        .quiz-card:hover {
            transform: translateY(-5px);
            border-color: var(--border2);
        }
        .quiz-card.java-card:hover { border-color: var(--java-border); box-shadow: 0 8px 32px rgba(168,85,247,.1); }
        .quiz-card.py-card:hover   { border-color: var(--py-border);   box-shadow: 0 8px 32px rgba(59,130,246,.1);  }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }
        .card-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .card-icon .material-symbols-outlined { font-size: 20px; }
        .icon-java { background: var(--java-dim); color: var(--java-color); }
        .icon-py   { background: var(--py-dim);   color: var(--py-color);   }

        .passed-pill {
            padding: 3px 10px;
            border-radius: 50px;
            font-size: .7rem;
            font-weight: 700;
            background: rgba(52,211,153,.12);
            color: var(--green);
            border: 1px solid var(--green-border);
            letter-spacing: .05em;
            white-space: nowrap;
        }

        .card-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.3;
        }
        .card-desc {
            font-size: .85rem;
            color: var(--text-dim);
            line-height: 1.55;
        }

        /* info chips */
        .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
        .chip {
            display: flex; align-items: center; gap: 5px;
            padding: 5px 10px;
            border-radius: 8px;
            background: rgba(255,255,255,.05);
            border: 1px solid var(--border);
            font-size: .75rem;
            color: var(--text-dim);
        }
        .chip .material-symbols-outlined { font-size: 14px; }

        /* score bar */
        .score-block {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
        }
        .score-row {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 8px;
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--text-dim);
        }
        .score-val-pass { color: var(--green); }
        .score-val-fail { color: #f87171; }
        .score-bar { height: 6px; background: rgba(255,255,255,.07); border-radius: 4px; overflow: hidden; }
        .score-fill { height: 100%; border-radius: 4px; transition: width .7s ease; }
        .fill-pass { background: linear-gradient(90deg, var(--green), #6ee7b7); }
        .fill-fail { background: linear-gradient(90deg, #f87171, #fca5a5); }

        /* action button */
        .btn-take {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: none;
            font-size: .9rem;
            font-weight: 600;
            font-family: 'Space Grotesk', sans-serif;
            cursor: pointer;
            text-decoration: none;
            transition: all .25s;
            margin-top: auto;
        }
        .btn-java {
            background: linear-gradient(135deg, var(--java-color), #c084fc);
            color: #fff;
            box-shadow: 0 4px 16px rgba(168,85,247,.2);
        }
        .btn-java:hover {
            background: linear-gradient(135deg, #c084fc, var(--java-color));
            box-shadow: 0 6px 24px rgba(168,85,247,.35);
            transform: translateY(-1px);
        }
        .btn-py {
            background: linear-gradient(135deg, var(--py-color), #60a5fa);
            color: #fff;
            box-shadow: 0 4px 16px rgba(59,130,246,.2);
        }
        .btn-py:hover {
            background: linear-gradient(135deg, #60a5fa, var(--py-color));
            box-shadow: 0 6px 24px rgba(59,130,246,.35);
            transform: translateY(-1px);
        }
        .btn-take .material-symbols-outlined { font-size: 18px; }

        /* empty state */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg3);
            border: 1px dashed var(--border2);
            border-radius: 16px;
        }
        .empty-icon {
            width: 72px; height: 72px;
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
        }
        .empty-icon .material-symbols-outlined { font-size: 36px; }
        .empty-state h3 { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
        .empty-state p  { color: var(--text-dim); font-size: .9rem; }

        /* scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgba(255,255,255,.03); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,.22); }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background-dark min-h-screen">
<div class="flex min-h-screen">
    @await Html.PartialAsync("_UserSidebar")

    <main class="qmain">
        <!-- Header -->
        <div class="page-header">
            <h1>Quiz Challenge</h1>
            <p>Pick a language and test your knowledge</p>
        </div>

        <!-- Stats strip -->
        <div class="stat-strip">
            <div class="stat-card">
                <div class="stat-icon si-purple">
                    <span class="material-symbols-outlined">quiz</span>
                </div>
                <div>
                    <div class="stat-num">@pathQuizzes.Count</div>
                    <div class="stat-lbl">Available</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon si-green">
                    <span class="material-symbols-outlined">check_circle</span>
                </div>
                <div>
                    <div class="stat-num">@passedAttempts</div>
                    <div class="stat-lbl">Passed</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon si-blue">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>
                <div>
                    <div class="stat-num">@Math.Round(avgScore, 0)%</div>
                    <div class="stat-lbl">Avg Score</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon si-yellow">
                    <span class="material-symbols-outlined">star</span>
                </div>
                <div>
                    <div class="stat-num">@Math.Round(bestScore, 0)%</div>
                    <div class="stat-lbl">Best Score</div>
                </div>
            </div>
        </div>

        <!-- Language toggle buttons -->
        <div class="lang-tabs" role="tablist">
            @if (defaultTab == "java")
            {
                <button class="lang-btn java-btn active" id="tab-java" role="tab"
                        aria-selected="true" aria-controls="panel-java"
                        onclick="switchTab('java')">
                    <span class="lang-dot"></span>
                    Java Quizzes
                    <span class="badge">@javaQuizzes.Count</span>
                </button>
            }
            @if (defaultTab == "python")
            {
                <button class="lang-btn py-btn active" id="tab-py" role="tab"
                        aria-selected="true" aria-controls="panel-python"
                        onclick="switchTab('python')">
                    <span class="lang-dot"></span>
                    Python Quizzes
                    <span class="badge">@pythonQuizzes.Count</span>
                </button>
            }
            @if (defaultTab == "web")
            {
                <button class="lang-btn web-btn active" id="tab-web" role="tab"
                        aria-selected="true" aria-controls="panel-web"
                        onclick="switchTab('web')">
                    <span class="lang-dot"></span>
                    Web Quizzes
                    <span class="badge">@webQuizzes.Count</span>
                </button>
            }
        </div>

        <!-- Java panel -->
        @if (defaultTab == "java")
        {
        <div class="quiz-panel active" id="panel-java" role="tabpanel" aria-labelledby="tab-java">
            <div class="panel-label">
                <h2>Java Quizzes</h2>
                <span class="pill pill-java">@javaQuizzes.Count available</span>
            </div>

            @if (javaQuizzes.Any())
            {
                <div class="quiz-grid">
                    @foreach (var quiz in javaQuizzes)
                    {
                        var qa  = attempts.Where(a => a.QuizId == quiz.Id).ToList();
                        var best = qa.Where(a => a.Score.HasValue).OrderByDescending(a => a.Score).FirstOrDefault();
                        var passed = best?.IsPassed == true;
                        <div class="quiz-card java-card">
                            <div class="card-top">
                                <div class="card-icon icon-java">
                                    <span class="material-symbols-outlined">code</span>
                                </div>
                                @if (passed)
                                {
                                    <span class="passed-pill">✓ PASSED</span>
                                }
                            </div>
                            <div>
                                <div class="card-title">@quiz.Title</div>
                                <div class="card-desc" style="margin-top:6px">@quiz.Description</div>
                            </div>
                            <div class="chip-row">
                                <div class="chip">
                                    <span class="material-symbols-outlined">help_outline</span>
                                    @quiz.QuestionCount questions
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">timer</span>
                                    @quiz.TimeLimitMinutes min
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">flag</span>
                                    Pass @quiz.PassingScore%
                                </div>
                            </div>
                            @if (best != null)
                            {
                                <div class="score-block">
                                    <div class="score-row">
                                        <span>Best Score</span>
                                        <span class="@(passed ? "score-val-pass" : "score-val-fail")">@Math.Round(best.Score ?? 0, 0)%</span>
                                    </div>
                                    <div class="score-bar">
                                        <div class="score-fill @(passed ? "fill-pass" : "fill-fail")"
                                             style="width:@(best.Score ?? 0)%"></div>
                                    </div>
                                </div>
                            }
                            <a href="@Url.Action("Take", "Quiz", new { quizId = quiz.Id })" class="btn-take btn-java">
                                <span class="material-symbols-outlined">
                                    @(best == null ? "play_arrow" : (passed ? "refresh" : "redo"))
                                </span>
                                @(best == null ? "Start Quiz" : (passed ? "Retake" : "Try Again"))
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon" style="background:var(--java-dim)">
                        <span class="material-symbols-outlined" style="color:var(--java-color)">code_off</span>
                    </div>
                    <h3>No Java Quizzes Yet</h3>
                    <p>Complete Java lessons to unlock quizzes</p>
                </div>
            }
        </div>
        }

        <!-- Web panel -->
        @if (defaultTab == "web")
        {
        <div class="quiz-panel active" id="panel-web" role="tabpanel" aria-labelledby="tab-web">
            <div class="panel-label">
                <h2>Web Quizzes</h2>
                <span class="pill pill-web">@webQuizzes.Count available</span>
            </div>

            @if (webQuizzes.Any())
            {
                <div class="quiz-grid">
                    @foreach (var quiz in webQuizzes)
                    {
                        var qa  = attempts.Where(a => a.QuizId == quiz.Id).ToList();
                        var best = qa.Where(a => a.Score.HasValue).OrderByDescending(a => a.Score).FirstOrDefault();
                        var passed = best?.IsPassed == true;
                        <div class="quiz-card web-card">
                            <div class="card-top">
                                <div class="card-icon icon-web">
                                    <span class="material-symbols-outlined">language</span>
                                </div>
                                @if (passed)
                                {
                                    <span class="passed-pill">✓ PASSED</span>
                                }
                            </div>
                            <div>
                                <div class="card-title">@quiz.Title</div>
                                <div class="card-desc" style="margin-top:6px">@quiz.Description</div>
                            </div>
                            <div class="chip-row">
                                <div class="chip">
                                    <span class="material-symbols-outlined">help_outline</span>
                                    @quiz.QuestionCount questions
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">timer</span>
                                    @quiz.TimeLimitMinutes min
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">flag</span>
                                    Pass @quiz.PassingScore%
                                </div>
                            </div>
                            @if (best != null)
                            {
                                <div class="score-block">
                                    <div class="score-row">
                                        <span>Best Score</span>
                                        <span class="@(passed ? "score-val-pass" : "score-val-fail")">@Math.Round(best.Score ?? 0, 0)%</span>
                                    </div>
                                    <div class="score-bar">
                                        <div class="score-fill @(passed ? "fill-pass" : "fill-fail")"
                                             style="width:@(best.Score ?? 0)%"></div>
                                    </div>
                                </div>
                            }
                            <a href="@Url.Action("Take", "Quiz", new { quizId = quiz.Id })" class="btn-take btn-web">
                                <span class="material-symbols-outlined">
                                    @(best == null ? "play_arrow" : (passed ? "refresh" : "redo"))
                                </span>
                                @(best == null ? "Start Quiz" : (passed ? "Retake" : "Try Again"))
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon" style="background:var(--web-dim)">
                        <span class="material-symbols-outlined" style="color:var(--web-color)">language</span>
                    </div>
                    <h3>No Web Quizzes Yet</h3>
                    <p>Complete Web Development lessons to unlock quizzes</p>
                </div>
            }
        </div>
        }

        <!-- Python panel -->
        @if (defaultTab == "python")
        {
        <div class="quiz-panel active" id="panel-python" role="tabpanel" aria-labelledby="tab-py">
            <div class="panel-label">
                <h2>Python Quizzes</h2>
                <span class="pill pill-py">@pythonQuizzes.Count available</span>
            </div>

            @if (pythonQuizzes.Any())
            {
                <div class="quiz-grid">
                    @foreach (var quiz in pythonQuizzes)
                    {
                        var qa  = attempts.Where(a => a.QuizId == quiz.Id).ToList();
                        var best = qa.Where(a => a.Score.HasValue).OrderByDescending(a => a.Score).FirstOrDefault();
                        var passed = best?.IsPassed == true;
                        <div class="quiz-card py-card">
                            <div class="card-top">
                                <div class="card-icon icon-py">
                                    <span class="material-symbols-outlined">terminal</span>
                                </div>
                                @if (passed)
                                {
                                    <span class="passed-pill">✓ PASSED</span>
                                }
                            </div>
                            <div>
                                <div class="card-title">@quiz.Title</div>
                                <div class="card-desc" style="margin-top:6px">@quiz.Description</div>
                            </div>
                            <div class="chip-row">
                                <div class="chip">
                                    <span class="material-symbols-outlined">help_outline</span>
                                    @quiz.QuestionCount questions
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">timer</span>
                                    @quiz.TimeLimitMinutes min
                                </div>
                                <div class="chip">
                                    <span class="material-symbols-outlined">flag</span>
                                    Pass @quiz.PassingScore%
                                </div>
                            </div>
                            @if (best != null)
                            {
                                <div class="score-block">
                                    <div class="score-row">
                                        <span>Best Score</span>
                                        <span class="@(passed ? "score-val-pass" : "score-val-fail")">@Math.Round(best.Score ?? 0, 0)%</span>
                                    </div>
                                    <div class="score-bar">
                                        <div class="score-fill @(passed ? "fill-pass" : "fill-fail")"
                                             style="width:@(best.Score ?? 0)%"></div>
                                    </div>
                                </div>
                            }
                            <a href="@Url.Action("Take", "Quiz", new { quizId = quiz.Id })" class="btn-take btn-py">
                                <span class="material-symbols-outlined">
                                    @(best == null ? "play_arrow" : (passed ? "refresh" : "redo"))
                                </span>
                                @(best == null ? "Start Quiz" : (passed ? "Retake" : "Try Again"))
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon" style="background:var(--py-dim)">
                        <span class="material-symbols-outlined" style="color:var(--py-color)">terminal</span>
                    </div>
                    <h3>No Python Quizzes Yet</h3>
                    <p>Complete Python lessons to unlock quizzes</p>
                </div>
            }
        </div>
        }
    </main>
</div>

<script>
    function switchTab(lang) {
        document.querySelectorAll('.lang-btn').forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.quiz-panel').forEach(p => p.classList.remove('active'));

        const map = {
            java:   { tab: 'tab-java', panel: 'panel-java' },
            python: { tab: 'tab-py',   panel: 'panel-python' },
            web:    { tab: 'tab-web',  panel: 'panel-web' }
        };
        const target = map[lang] || map.java;
        document.getElementById(target.tab).classList.add('active');
        document.getElementById(target.tab).setAttribute('aria-selected', 'true');
        document.getElementById(target.panel).classList.add('active');

        const cards = document.querySelectorAll('.quiz-panel.active .quiz-card');
        cards.forEach((c, i) => {
            c.style.animation = 'none';
            void c.offsetWidth;
            c.style.animation = `cardIn .4s ease ${i * 80}ms both`;
        });
    }
</script>
</body>
</html>
