    <script>
    // ── 1. PARTICLE CANVAS ──────────────────────────────────────────
    (function(){
        const cv = document.getElementById('bgc'), cx = cv.getContext('2d');
        let W, H, P, mouse = {x:-9999,y:-9999};
        function resize(){ W=cv.width=window.innerWidth; H=cv.height=window.innerHeight; }
        resize(); window.addEventListener('resize', resize);
        window.addEventListener('mousemove', e=>{ mouse.x=e.clientX; mouse.y=e.clientY; });
        const N = Math.min(110, Math.floor(window.innerWidth*window.innerHeight/9500));
        P = Array.from({length:N}, ()=>({
            x:Math.random()*window.innerWidth, y:Math.random()*window.innerHeight,
            vx:(Math.random()-.5)*.38, vy:(Math.random()-.5)*.38,
            r:Math.random()*1.4+.4, op:Math.random()*.45+.18,
            hue:Math.random()>.65?280:(Math.random()>.5?270:260)
        }));
        function frame(){
            cx.clearRect(0,0,W,H);
            for(let i=0;i<P.length;i++){
                const p=P[i];
                const dx=p.x-mouse.x, dy=p.y-mouse.y, d=Math.sqrt(dx*dx+dy*dy);
                if(d<130){ const f=(130-d)/130; p.vx+=(dx/d)*f*.28; p.vy+=(dy/d)*f*.28; }
                p.vx*=.99; p.vy*=.99;
                const sp=Math.sqrt(p.vx*p.vx+p.vy*p.vy);
                if(sp>1.4){p.vx=p.vx/sp*1.4;p.vy=p.vy/sp*1.4;}
                p.x+=p.vx; p.y+=p.vy;
                if(p.x<0)p.x=W; if(p.x>W)p.x=0;
                if(p.y<0)p.y=H; if(p.y>H)p.y=0;
                cx.beginPath(); cx.arc(p.x,p.y,p.r,0,Math.PI*2);
                cx.fillStyle=`hsla(${p.hue},68%,68%,${p.op})`; cx.fill();
                for(let j=i+1;j<P.length;j++){
                    const q=P[j], ex=p.x-q.x, ey=p.y-q.y, ed=Math.sqrt(ex*ex+ey*ey);
                    if(ed<95){ cx.beginPath(); cx.moveTo(p.x,p.y); cx.lineTo(q.x,q.y);
                        cx.strokeStyle=`hsla(280,68%,75%,${(1-ed/95)*.13})`; cx.lineWidth=.5; cx.stroke(); }
                }
            }
            requestAnimationFrame(frame);
        }
        frame();
    })();

    // ── 2. CUSTOM CURSOR ────────────────────────────────────────────
    (function(){
        const dot=document.getElementById('cdot'), ring=document.getElementById('cring');
        let mx=0,my=0,rx=0,ry=0;
        document.addEventListener('mousemove', e=>{ mx=e.clientX; my=e.clientY; dot.style.left=mx+'px'; dot.style.top=my+'px'; });
        (function anim(){ rx+=(mx-rx)*.12; ry+=(my-ry)*.12; ring.style.left=rx+'px'; ring.style.top=ry+'px'; requestAnimationFrame(anim); })();
        document.querySelectorAll('a,button').forEach(el=>{
            el.addEventListener('mouseenter',()=>{ ring.style.width='52px'; ring.style.height='52px'; ring.style.borderColor='rgba(184,135,227,.7)'; dot.style.transform='translate(-50%,-50%) scale(1.5)'; });
            el.addEventListener('mouseleave',()=>{ ring.style.width='36px'; ring.style.height='36px'; ring.style.borderColor='rgba(184,135,227,.45)'; dot.style.transform='translate(-50%,-50%) scale(1)'; });
        });
    })();

    // ── 3. SCROLL REVEAL ────────────────────────────────────────────
    (function(){
        const io = new IntersectionObserver(entries=>{
            entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
        },{threshold:.1,rootMargin:'0px 0px -40px 0px'});
        document.querySelectorAll('.rv,.rvl,.rvr').forEach(el=>io.observe(el));
    })();

    // ── 4. ANIMATED COUNTERS ────────────────────────────────────────
    (function(){
        const io = new IntersectionObserver(entries=>{
            entries.forEach(e=>{
                if(!e.isIntersecting) return;
                io.unobserve(e.target);
                const el = e.target;
                const target = +el.dataset.to;
                el.textContent = '0';
                // delay slightly so the reveal fade-in finishes first
                setTimeout(()=>{
                    let start = null;
                    const duration = 1800;
                    const step = ts => {
                        if(!start) start = ts;
                        const p = Math.min((ts - start) / duration, 1);
                        // ease-out expo for snappy start, graceful end
                        const ease = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
                        el.textContent = Math.floor(ease * target);
                        if(p < 1) requestAnimationFrame(step);
                        else el.textContent = target;
                    };
                    requestAnimationFrame(step);
                }, 400);
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.counter').forEach(c => io.observe(c));
    })();

    // ── 5. NAVBAR SCROLL ────────────────────────────────────────────
    window.addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('scrolled',scrollY>50));

    // ── 6. 3D TILT ON FEATURE CARDS ─────────────────────────────────
    document.querySelectorAll('.fcard').forEach(card=>{
        card.addEventListener('mousemove',e=>{
            const r=card.getBoundingClientRect(), x=(e.clientX-r.left)/r.width, y=(e.clientY-r.top)/r.height;
            card.style.transform=`perspective(900px) rotateX(${(y-.5)*9}deg) rotateY(${(.5-x)*9}deg) translateY(-5px)`;
            card.style.setProperty('--mx',`${x*100}%`); card.style.setProperty('--my',`${y*100}%`);
        });
        card.addEventListener('mouseleave',()=>{ card.style.transform=''; });
    });

    // ── 7. PATH CARD GLOW FOLLOW ─────────────────────────────────────
    document.querySelectorAll('.pcard').forEach(card=>{
        card.addEventListener('mousemove',e=>{
            const r=card.getBoundingClientRect(), g=card.querySelector('.pcglow');
            if(g){ g.style.left=(e.clientX-r.left-100)+'px'; g.style.top=(e.clientY-r.top-100)+'px'; }
        });
    });
    </script>
</body>
