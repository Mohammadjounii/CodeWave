        s.textContent =
            '@@keyframes cwFu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}' +
            '@@keyframes cwSpin{to{transform:rotate(360deg)}}' +
            '.cw-card{transition:transform .2s,border-color .2s,box-shadow .2s}' +
            '.cw-card:hover{transform:translateY(-2px)}';
        document.head.appendChild(s);
    })();

    // ── Build overlay DOM ─────────────────────────────────────────────
    function buildOverlay() {
        var ov = document.createElement('div');
        ov.id = 'cwSearchOverlay';
        ov.setAttribute('role', 'dialog');
