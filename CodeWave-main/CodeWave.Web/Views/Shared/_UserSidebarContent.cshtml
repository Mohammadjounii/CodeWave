// ── Path restriction utilities (available on every page via sidebar) ──────────

window.cwShouldBlock = function(type, resultPath) {
    try {
        if (!resultPath || !resultPath.trim()) return false;
        const restricted = ['course', 'lesson', 'quiz', 'exercise'];
        if (!restricted.includes((type || '').toLowerCase())) return false;
        const userPath = (document.getElementById('cwUserPath')?.dataset.path || '').toLowerCase().trim();
        if (!userPath) return false;
        const rp = resultPath.toLowerCase().trim();
        if (!rp) return false;
        // Use language-level matching (handles "Java", "Java Programming", etc.)
        const lang = s => s.includes('python') ? 'python' : s.includes('java') ? 'java' : s.includes('web') ? 'web' : null;
        const uLang = lang(userPath);
        const rLang = lang(rp);
        if (!uLang || !rLang) return false; // Unknown path → never block
        return uLang !== rLang;
    } catch(_) { return false; }
};

window.cwShowPathToast = function(resultPath) {
    const t = document.getElementById('cwPathToast');
    const m = document.getElementById('cwToastMsg');
    if (!t || !m) return;

    const dark = document.documentElement.classList.contains('dark');
    t.style.background  = dark ? '#1c1c28' : '#ffffff';
    t.style.border      = dark ? '1px solid rgba(255,255,255,0.1)' : '1px solid #e5e7eb';
    t.style.color       = dark ? '#f1f5f9' : '#111827';

    // Build message safely (no innerHTML XSS)
    m.innerHTML = '';
    const strong = Object.assign(document.createElement('strong'), { textContent: resultPath });
    const link   = Object.assign(document.createElement('a'),      { href: '/Settings', textContent: 'Switch in Settings' });
    link.style.cssText = 'color:#b887e3;text-decoration:underline;font-weight:600';
    m.append('This is ', strong, ' content. ', link, '.');

    // Animate in
    t.style.transform    = 'translateY(30px)';
    t.style.opacity      = '0';
    t.style.pointerEvents = 'auto';
    requestAnimationFrame(() => requestAnimationFrame(() => {
        t.style.transform = 'translateY(0)';
        t.style.opacity   = '1';
    }));

    clearTimeout(window._cwToastTimer);
    window._cwToastTimer = setTimeout(() => window.cwDismissPathToast(), 5000);
};

window.cwDismissPathToast = function() {
    const t = document.getElementById('cwPathToast');
    if (!t) return;
    t.style.transform = 'translateY(30px)';
    t.style.opacity   = '0';
    setTimeout(() => { t.style.pointerEvents = 'none'; }, 350);
};
</script>

