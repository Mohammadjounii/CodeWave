            'position:fixed;inset:0;z-index:10000;display:none;' +
            'align-items:flex-start;justify-content:center;padding:60px 20px 24px;';

        ov.innerHTML =
            '<div id="cwOvBackdrop" style="position:absolute;inset:0;background:rgba(4,4,12,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)"></div>' +
            '<div id="cwOvPanel" style="position:relative;z-index:1;width:100%;max-width:700px;border-radius:22px;overflow:hidden;' +
                'display:flex;flex-direction:column;max-height:calc(100vh - 100px);' +
