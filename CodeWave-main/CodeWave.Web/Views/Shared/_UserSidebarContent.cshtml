<script>
    // Theme toggle button functionality
    (function() {
        function initThemeToggle() {
            const themeToggle = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-icon');
            const themeText = document.getElementById('theme-text');
            const html = document.documentElement;
            
            if (!themeToggle || !themeIcon || !themeText) {
                // Retry if elements aren't ready yet
                setTimeout(initThemeToggle, 100);
                return;
            }
            
            // Update button state based on current theme
            const updateButton = () => {
                const isDark = html.classList.contains('dark');
                if (isDark) {
                    themeIcon.textContent = 'light_mode';
                    themeText.textContent = 'Light Mode';
                } else {
                    themeIcon.textContent = 'dark_mode';
                    themeText.textContent = 'Dark Mode';
                }
            };
            
            // Initialize button state
            updateButton();
            
            // Toggle theme on button click
            themeToggle.addEventListener('click', () => {
                const isDark = html.classList.contains('dark');
                const newTheme = isDark ? 'light' : 'dark';
                
                // Remove both classes first
                html.classList.remove('dark', 'light');
                
                // Apply new theme
                if (newTheme === 'dark') {
                    html.classList.add('dark');
                } else {
                    // For light mode, ensure dark class is removed
                    html.classList.remove('dark');
                }
                
                // Save preference
                localStorage.setItem('theme', newTheme);
                
                // Debug: Log theme change
                console.log('Theme toggled to:', newTheme, 'HTML classes:', html.className, 'Has dark:', html.classList.contains('dark'));
                
                // Force a repaint to ensure changes are visible
                void html.offsetHeight;
                
                // Trigger a reflow to ensure CSS is reapplied
                document.body.style.display = 'none';
                void document.body.offsetHeight;
                document.body.style.display = '';
                
                // Update button
                updateButton();
            });
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initThemeToggle);
        } else {
            initThemeToggle();
        }
    })();
</script>

<!-- Profile Picture Modal (shared across all pages via sidebar) -->
<div id="profilePictureModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm">
    <div class="bg-white dark:bg-[#111318] rounded-xl p-8 max-w-md w-full mx-4 border border-gray-200 dark:border-[#3b4354] shadow-2xl">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-gray-900 dark:text-white text-2xl font-bold">Profile Picture</h2>
            <button onclick="closeProfilePictureModal()" class="text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="flex flex-col items-center gap-6">
            <div class="size-48 rounded-full bg-cover bg-center bg-no-repeat border-4 border-primary shadow-lg"
                 id="modalProfilePicture"
                 style='background-image:url("@displayPictureUrl"); background-color: #4a5568;'>
            </div>
            <p id="profilePictureStatus" class="text-sm text-center min-h-[1.25rem]"></p>
            <form id="profilePictureForm" asp-controller="Home" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="w-full">
                @Html.AntiForgeryToken()
                <label for="profilePictureInput" id="profilePictureLabel" class="flex items-center justify-center gap-2 w-full bg-primary text-white h-12 px-6 rounded-lg hover:bg-primary/90 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-white">upload</span>
                    <span>Change Picture</span>
                </label>
                <input type="file" id="profilePictureInput" name="profilePicture" accept="image/jpeg,image/jpg,image/png,image/gif" class="hidden" onchange="handleProfilePictureSelect(this)" />
            </form>
        </div>
    </div>
</div>

<script>
    function openProfilePictureModal() {
        var modal = document.getElementById('profilePictureModal');
        // Some pages wrap their main content in a stacking context of its own
        // (a sticky header/toolbar or decorative overlay with z-10+), which — since
        // the sidebar itself establishes a stacking context via position:sticky —
        // would bury this modal no matter how high its own z-index is. Re-parenting
        // it onto <body> escapes every ancestor's stacking context entirely.
        if (modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeProfilePictureModal() {
        document.getElementById('profilePictureModal').classList.add('hidden');
        document.getElementById('profilePictureModal').classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    function setProfilePictureStatus(message, isError) {
        var status = document.getElementById('profilePictureStatus');
        status.textContent = message || '';
        status.className = 'text-sm text-center min-h-[1.25rem] ' + (isError ? 'text-red-500' : 'text-primary');
    }

    async function handleProfilePictureSelect(input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];

        if (file.size > 5 * 1024 * 1024) {
            setProfilePictureStatus('File size too large. Please upload an image smaller than 5MB.', true);
            input.value = '';
            return;
        }
        var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
        if (!allowedTypes.includes(file.type)) {
            setProfilePictureStatus('Invalid file type. Please upload a JPG, PNG, or GIF image.', true);
            input.value = '';
            return;
        }

        var reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('modalProfilePicture').style.backgroundImage = 'url(' + e.target.result + ')';
        };
        reader.readAsDataURL(file);

        var form = document.getElementById('profilePictureForm');
        var label = document.getElementById('profilePictureLabel');
        label.classList.add('opacity-60', 'pointer-events-none');
        setProfilePictureStatus('Uploading…', false);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            });
            const result = await response.json().catch(function () { return null; });

            if (response.ok && result && result.success) {
                setProfilePictureStatus(result.message || 'Profile picture updated!', false);
                var sidebarPic = document.getElementById('sidebarProfilePicture');
                if (sidebarPic) sidebarPic.style.backgroundImage = 'url(' + result.url + ')';
            } else {
                setProfilePictureStatus((result && result.message) || 'Failed to update profile picture.', true);
            }
        } catch (err) {
            setProfilePictureStatus('Network error — please try again.', true);
        } finally {
            label.classList.remove('opacity-60', 'pointer-events-none');
            input.value = '';
        }
    }

    document.getElementById('profilePictureModal').addEventListener('click', function(e) {
        if (e.target === this) closeProfilePictureModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeProfilePictureModal();
    });
</script>

<script>
// ── (dropdown IIFE removed — search now uses full overlay) ──────────────────

// placeholder so any old cwGo refs don't error
window.cwGo = function(url) { if (url) window.location.href = url; };

/* DELETED_IIFE_START
    purple: { icon:'#b887e3', bg:'rgba(184,135,227,0.12)' },
        blue:   { icon:'#3b82f6', bg:'rgba(59,130,246,0.12)'  },
        yellow: { icon:'#f59e0b', bg:'rgba(245,158,11,0.12)'  },
        orange: { icon:'#f97316', bg:'rgba(249,115,22,0.12)'  },
        green:  { icon:'#10b981', bg:'rgba(16,185,129,0.12)'  },
        rose:   { icon:'#f43f5e', bg:'rgba(244,63,94,0.12)'   },
        indigo: { icon:'#6366f1', bg:'rgba(99,102,241,0.12)'  },
        cyan:   { icon:'#06b6d4', bg:'rgba(6,182,212,0.12)'   },
    };

    let debounce  = null;
    let query     = '';
    let activeIdx = -1;
    let items     = [];

    const input   = document.getElementById('sidebarSearchInput');
    const box     = document.getElementById('sidebarSearchBox');
    const icon    = document.getElementById('sidebarSearchIcon');
    const clearBtn= document.getElementById('sidebarClearBtn');
    const dd      = document.getElementById('sidebarSearchDropdown');
    const resDiv  = document.getElementById('sidebarSearchResults');
    const loading = document.getElementById('sidebarSearchLoading');
    const footer  = document.getElementById('sidebarSearchFooter');
    const allBtn  = document.getElementById('sidebarSearchAll');
    const allText = document.getElementById('sidebarSearchAllText');

    if (!input) return;

    // expose globally for form onsubmit
    window.cwSubmitSearch = function(e) {
        e.preventDefault();
        const q = input.value.trim();
        if (q) { hideDropdown(); window.cwOpenSearch ? window.cwOpenSearch(q) : navigate('/Search?q=' + enc(q)); }
    };
    window.cwClearSearch = function() {
        input.value = '';
        clearBtn.classList.add('hidden');
        hideDropdown();
        input.focus();
    };

    // ── input events ──────────────────────────────────────────────────
    input.addEventListener('focus', () => {
        icon.style.color = '#b887e3';
        if (query.length >= 2 && items.length) showDropdown();
    });

    input.addEventListener('input', () => {
        const q = input.value.trim();
        clearBtn.classList.toggle('hidden', q.length === 0);
        activeIdx = -1;
        clearTimeout(debounce);

        if (q.length < 2) { hideDropdown(); return; }

        showLoading();
        debounce = setTimeout(() => fetch2(q), 260);
    });

    input.addEventListener('keydown', e => {
        const rows = resDiv.querySelectorAll('.cw-item');
        if (e.key === 'ArrowDown')  { e.preventDefault(); moveFocus(rows, 1); }
        else if (e.key === 'ArrowUp')   { e.preventDefault(); moveFocus(rows, -1); }
        else if (e.key === 'Enter')     { e.preventDefault(); pickActive(); }
        else if (e.key === 'Escape')    { hideDropdown(); input.blur(); }
    });

    input.addEventListener('blur', () => {
        if (!input.value) icon.style.color = '';
    });

    document.addEventListener('mousedown', e => {
        if (!document.getElementById('sidebarSearchWrapper')?.contains(e.target)) {
            hideDropdown();
        }
    });

    allBtn?.addEventListener('click', () => {
        hideDropdown();
        window.cwOpenSearch ? window.cwOpenSearch(query) : navigate('/Search?q=' + enc(query));
    });

    // ── fetch ─────────────────────────────────────────────────────────
    async function fetch2(q) {
        try {
            query = q;
            const res  = await fetch('/Search/Suggestions?q=' + enc(q));
            items = await res.json();
            render(items, q);
        } catch (_) { hideDropdown(); }
    }

    // ── render suggestions ────────────────────────────────────────────
    function render(data, q) {
        loading.classList.add('hidden');
        const dark = document.documentElement.classList.contains('dark');

        if (!data.length) {
            resDiv.innerHTML = `
                <div style="padding:20px 16px;text-align:center">
                    <span class="material-symbols-outlined" style="font-size:30px;color:${dark?'#334155':'#d1d5db'};display:block;margin-bottom:4px">search_off</span>
                    <p style="font-size:12px;color:${dark?'#64748b':'#9ca3af'}">No results for <b>${esc(q)}</b></p>
                </div>`;
            footer.classList.add('hidden');
            showDropdown();
            return;
        }

        resDiv.innerHTML = data.map((r, i) => {
            const c = TC[r.typeColor] || TC.purple;
            const hoverBg = dark ? 'rgba(255,255,255,0.05)' : 'rgba(249,250,251,1)';
            return `
            <button data-i="${i}" class="cw-item"
                onclick="cwGo('${esc(r.url)}','${esc(r.type)}','${esc(r.learningPath||'')}')"
                style="width:100%;display:flex;align-items:center;gap:10px;padding:8px 12px;border:none;background:transparent;cursor:pointer;text-align:left;transition:background .12s"
                onmouseenter="this.style.background='${hoverBg}'"
                onmouseleave="this.style.background='transparent'"
            >
                <div style="padding:6px;border-radius:8px;background:${c.bg};flex-shrink:0">
                    <span class="material-symbols-outlined" style="font-size:16px;color:${c.icon};display:block">${esc(r.typeIcon)}</span>
                </div>
                <div style="flex:1;min-width:0;overflow:hidden">
                    <p style="font-size:13px;font-weight:500;color:${dark?'#f1f5f9':'#111827'};white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${highlight(esc(r.title), esc(q))}</p>
