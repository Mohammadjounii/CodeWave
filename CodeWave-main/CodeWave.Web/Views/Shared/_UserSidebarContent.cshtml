                    var d = idx++ * 25;
                    html +=
                        '<div role="button" tabindex="0" data-url="' + x(r.url) + '" data-type="' + x(r.type) + '" data-path="' + x(r.learningPath||'') + '" ' +
                        'class="cw-result" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:11px;cursor:pointer;animation:cwFu .3s ' + d + 'ms ease both;transition:background .14s" ' +
                        'onmouseenter="this.style.background=\'' + hoverBg + '\'" onmouseleave="this.style.background=\'transparent\'">' +
                            '<div style="padding:7px;border-radius:9px;background:' + g.bg + ';flex-shrink:0"><span class="material-symbols-outlined" style="font-size:16px;color:' + g.c + ';display:block">' + x(r.typeIcon||g.icon) + '</span></div>' +
                            '<div style="flex:1;min-width:0;overflow:hidden">' +
                                '<p style="font-weight:600;font-size:13px;color:' + text + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0 0 2px">' + x(r.title) + '</p>' +
                                (r.excerpt ? '<p style="font-size:11px;color:' + muted + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0">' + x(r.excerpt) + '</p>' : '') +
                            '</div>' +
                            '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0">' +
                                (r.learningPath ? '<span style="font-size:10px;font-weight:500;padding:3px 8px;border-radius:999px;background:rgba(184,135,227,.1);color:#b887e3">' + x(r.learningPath) + '</span>' : '') +
                                '<span class="material-symbols-outlined" style="font-size:16px;color:' + muted + '">arrow_forward</span>' +
                            '</div>' +
                        '</div>';
                });
            }
            html += '</div>';
        });

        container.innerHTML = html;

        // Click handlers on all result cards
        container.querySelectorAll('.cw-result').forEach(function(card) {
            card.addEventListener('click', function() {
                try {
                    var url  = card.dataset.url;
                    var type = card.dataset.type;
                    var path = card.dataset.path || '';
                    if (window.cwShouldBlock && window.cwShouldBlock(type, path)) {
                        window.cwShowPathToast && window.cwShowPathToast(path);
                        shakeEl(card); return;
                    }
                    window.cwCloseSearch();
                    setTimeout(function() { window.location.href = url; }, 90);
                } catch(_) {}
            });
            card.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
            });
        });

        if (footer) {
            footer.style.display = 'flex';
            var cnt = document.getElementById('cwOvCount');
            if (cnt) cnt.textContent = total + ' result' + (total === 1 ? '' : 's');
        }
    }

    window.cwOvFilter = function(type) {
        document.querySelectorAll('[id^="cwOvF-"]').forEach(function(btn) {
            var active = btn.dataset.filter === type;
            btn.style.background  = active ? 'rgba(184,135,227,.15)' : (document.documentElement.classList.contains('dark') ? 'rgba(255,255,255,.07)' : 'rgba(229,231,235,.9)');
            btn.style.color       = active ? '#b887e3' : (document.documentElement.classList.contains('dark') ? '#94a3b8' : '#374151');
            btn.style.fontWeight  = active ? '600' : '500';
        });
        document.querySelectorAll('.cw-ov-group').forEach(function(g) {
            g.style.display = (type === 'all' || g.dataset.gtype === type) ? '' : 'none';
        });
    };

    // ── Loading / error / init states ─────────────────────────────────
    function showSpinner() {
        var c = document.getElementById('cwOvResults');
        if (!c) return;
        var muted = document.documentElement.classList.contains('dark') ? '#64748b' : '#9ca3af';
        c.innerHTML =
            '<div style="display:flex;align-items:center;justify-content:center;gap:12px;padding:56px 20px">' +
            '<div style="width:20px;height:20px;border-radius:50%;border:2.5px solid #b887e3;border-top-color:transparent;animation:cwSpin .7s linear infinite"></div>' +
            '<span style="font-size:13px;color:' + muted + '">Searching…</span></div>';
        var f = document.getElementById('cwOvFooter'); if(f) f.style.display='none';
        var fil = document.getElementById('cwOvFilters'); if(fil) fil.style.display='none';
    }

    function showError() {
        var c = document.getElementById('cwOvResults');
        if (c) c.innerHTML = '<div style="text-align:center;padding:40px;color:#f43f5e;font-size:13px">Something went wrong. Please try again.</div>';
    }

    function showInit() {
        var c = document.getElementById('cwOvResults');
        if (!c) return;
        var dark  = document.documentElement.classList.contains('dark');
        var text  = dark ? '#f1f5f9' : '#111827';
        var muted = dark ? '#64748b' : '#9ca3af';
        c.innerHTML =
            '<div style="text-align:center;padding:52px 20px 40px">' +
            '<span class="material-symbols-outlined" style="font-size:56px;color:#b887e3;display:block;margin-bottom:14px;font-variation-settings:\'FILL\' 0,\'wght\' 200">search</span>' +
            '<p style="font-weight:700;font-size:17px;color:' + text + ';margin:0 0 8px">Find anything in CodeWave</p>' +
            '<p style="font-size:13px;color:' + muted + ';margin:0 0 22px">Courses · Lessons · Quizzes · Achievements · Jobs · More</p>' +
            '<div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center">' +
            ['Python','Java','OOP','Functions','Quiz','Interview','Job','Achievements'].map(function(kw) {
                return '<button onclick="cwSearchQuick(\'' + kw + '\')" style="font-size:12px;font-weight:500;padding:6px 14px;border-radius:999px;border:1px solid rgba(184,135,227,.3);background:rgba(184,135,227,.08);color:#b887e3;cursor:pointer;font-family:inherit;transition:background .15s" onmouseenter="this.style.background=\'rgba(184,135,227,.2)\'" onmouseleave="this.style.background=\'rgba(184,135,227,.08)\'">' + kw + '</button>';
            }).join('') + '</div></div>';
        var f = document.getElementById('cwOvFilters'); if(f) f.style.display='none';
        var ft = document.getElementById('cwOvFooter'); if(ft) ft.style.display='none';
    }

    // ── Helpers ───────────────────────────────────────────────────────
    function shakeEl(el) {
        if (!el) return;
        el.style.transition = 'transform .08s ease';
        ['-7px','7px','-3px','0'].forEach(function(v, i) {
            setTimeout(function() { el.style.transform = 'translateX(' + v + ')'; }, i * 75);
        });
    }
    function dBg(d) { return d==='Beginner'?'rgba(16,185,129,.1)':d==='Intermediate'?'rgba(245,158,11,.1)':'rgba(244,63,94,.1)'; }
    function dC(d)  { return d==='Beginner'?'#10b981':d==='Intermediate'?'#f59e0b':'#f43f5e'; }
    function x(s)   { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // ── Global keyboard shortcuts (Ctrl+K and Escape) ─────────────────
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            window.cwOpenSearch('');
        }
        if (e.key === 'Escape') {
            var ov = document.getElementById('cwSearchOverlay');
            if (ov && ov.style.display !== 'none') window.cwCloseSearch();
        }
    });

})();
</script>
